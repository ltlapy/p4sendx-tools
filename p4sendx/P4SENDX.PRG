' SCREENSHOT 2BIT/PIXEL(226800BYTE/IMAGE)
'////////////////////////////////////////////////
'INITIALIZE
ACLS
VAR ISSUB%,ENVT%,ENVP%
ENVTYPE OUT ENVT%,ENVP%
ISSUB%=(ENVT%==1)
SUBFIT 400,240
IF ISSUB% THEN
 'FILES GO TO THE PROJECT THE MAIN SIDE IS IN, WHEREVER THIS WAS LOADED FROM
 ENVPROJECT
 FOR I%=1 TO 3
  IF ENVFOCUS() THEN BREAK
  ENVFOCUS 1
  VSYNC 5
 NEXT
ENDIF
