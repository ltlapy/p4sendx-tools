DEF UUNPACKED N%
 UV 8,12,52,47,"UNPACKED "+UN$(N%)+" B IN "+FORMAT$("%.1F",(MILLISEC()-BT0%-BST%)/1000)+" S",UCL%
END

DEF UFILES N%
 VAR P#
 IF N%==0 THEN
  UT 12,102,"FILES",UCL%
  UBARNEW
  UT 12,142,"FILE",UCL%
  UT 12,172,"WRITTEN",UCL%
  UT 112,172,"IGNORED",UCL%
  UT 240,172,"FAILED",UCL%
 ENDIF
