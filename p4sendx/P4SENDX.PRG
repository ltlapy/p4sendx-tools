  RGB(85,85,85),RGB(128,128,128), \
  RGB(170,170,170),RGB(213,213,213), \
  RGB(255,255,255) ]
DIM CRCTBL%[]:CRCTBL%=CALC_CRCTBL()
VAR DUMMY%
DIM ML$[]

'SYNCKEY
DIM SB%[]
DIM SKT%[25]
VAR SK0%
'RECEIVE
VAR STATE%,FILELEN%,FILENAME$,FILECRC%
VAR GRPW%,GRPH%,COMP%
VAR CLK%,BCLK%,MK%,BMK%,D#,RBUF%,RBIT%,DL%,DH%
VAR FT$
DIM REC%[],RZC%[],RZC32%[],RFC%[],VK%[]
DIM FG%[],FI%[]
'SCREENSHOT
VAR HDS%,SCS%,TIMG%,IMG%,STLEN%,XOR8%,XOR32%
DIM FL$[],HD%[]
'PARTS OF ARCHIVES
VAR BFORCE%,BCUR%,BI%,BNG%,BNB%,BK%,BR%,BNEED%,ARSET%,ARID%,ARN%
VAR BONES%,LOSTP%,LASTPK%,RP%,RW%,BP%,BC%,BENT%,BOK%,BBAD%,BDL%,BE%
VAR OP%,BAD%,RI%,ZK%,ZL%,BALARM%,BALARMAT%,BALARMGAP%=300
VAR ZS%,ZF%,ZFN%,ZE%,ZP%,ZN%,ZD%,ZX%,ZERR%,ZB%,BIMG%,BIMGN%,BMETH%,BTIME%,BT0%,BPW%
VAR BCNT%,BDST%,BPOS%,BSIZE%,BCRC%,BW%,CM%,TM%
VAR BN$,BN1$,BN2$,BERR$
'WHAT THE FILES ARE COMPARED WITH, AND HOW LONG THEY TOOK
VAR BSM%,BNS%,BST%,BSN%,BS0%,BX%,BY%,BOLD
DIM BFX$[]
VAR PG%,PD%,PI%,PN%,PX%,PJ%,PM%,PAL%,PAH%,PAM%,REP%,BREP%,BMIS%
VAR ONEREP%=-1
DIM GL%[],GH%[],GM%[]
'THE NS LINKS, NS1 6 KEYBOARDS, NS2 7: 6 OF 27 KEYS ON EACH, THEIR COMBINATION NUMBER 18 BITS. WITHOUT
'ENTER, ESC, BACKSPACE, TAB, SPACE AND KEYPAD ENTER. DOCS/PROTOCOL.MD HAS THE FORMAT
CONST #X_MARK=&H2B4A5,#X_SAME=262144
VAR XM%,XT%,XOK%,XQ%,XJ%,XK%,XR%,XS%,XSKIP%,XDI%,XDN%,XP%
VAR XB%,XN%,XH%,XHC%,XNC%,XCK%,XST%,XLATE%,BLATE%,ONELAT%=-1
DIM KX%[189],XC%[162],XV%[7],PA%[7],GV%[],XSK%[195],XLC%[7],XLV%[7],XHV%[7]
COPY XSK%,KEYCODE%
SORT XSK%
XQ%=0
FOR XJ%=0 TO 194
 XR%=XSK%[XJ%]
 IF (XR%<40 || XR%>44) && XR%!=88 THEN KX%[XQ%]=XR%:INC XQ%
NEXT
FOR XK%=0 TO 26
 XC%[XK%]=XK%
NEXT
FOR XJ%=1 TO 5
 FOR XK%=1 TO 26
  XC%[XJ%*27+XK%]=XC%[(XJ%-1)*27+XK%-1]+XC%[XJ%*27+XK%-1]
 NEXT
NEXT
DIM BPF$[],BPG%[],BGID%[],BGN%[],BGC%[],BHAVE%[],BFLN$[],BFLR$[]
DIM RB%[],BUF%[],FW%[],CRC32TBL%[],RG%[]
'SOUNDS: C D E G A AT A4=440 ONLY, SO THAT THE FLIPPER'S NOTES AGREE WITH THEM.
'@12 IS THE INSTRUMENT. 128 CLIMBS TO THE OCTAVE: DONE. 129 REPEATS ONE NOTE: THE USER IS NEEDED.
'SET HERE SO THAT PLAYING THEM COMPILES NOTHING. THEY PLAY ON TRACK 0.
BGMSET 128,"T150@12V60O5L16CEG<C"
BGMSET 129,"T150@12V60O5L16CCCR8CCC"
'THE SCREEN, ON GRP0. A PICTURE ON ITS WAY TO A FILE GOES THROUGH GRP1
CONST #U_BUCKETS=15,#U_BUCKET_F=600,#U_GREY_F=1200,#U_RISE_F=300,#U_TICK=6
CONST #U_S4=0.95,#U_S3=0.8,#U_S2=0.5,#U_S1=0.2,#U_ONEFILE=16447,#U_CELLS=180
VAR UVER$,UCB%=RGB(0,0,0),UCG%=RGB(72,72,80),UCL%=RGB(150,150,160),UCW%=RGB(235,235,240)
VAR UCK%=RGB(70,200,110),UCO%=RGB(240,145,50),UCY%=RGB(245,210,90),UCT%=RGB(90,200,200)
'WHAT IS SHOWN, AND THE SYNC KEY FOUND THIS SESSION
VAR UMODE%,USK%=-1,URN%,UFULL%,UGAP%,UEND%,UTRYK%=-1,UTRYN%,URT%,BSEEN%,UNX%,UG%
VAR UBAR%,UPX%,USPN%,UFR0%,UPK%,UTF%,UTB%,UALLP%
DIM UFP%[1],UCV$[16],USPB%[5],USPF%[5],USPP%[5]
DIM UR$[],UD$[],UI$[]
'THE SIGNAL: BUCKETS OF ACTIVE RECEPTION
DIM UBP%[#U_BUCKETS],UBM%[#U_BUCKETS],UBG%[#U_BUCKETS],UBF%[#U_BUCKETS]
VAR USI%,USE%,USM%,USG%,USF%,UCP%,UCM%,UCGR%,UCGF%,UAF%,UACT%,ULAST%,USIG%=-1,USUP%,UPFAIL%,UPG#

READ MES$:READ MES$
UVER$="VER "+MID$(MES$,INSTR(MES$,"VER.")+4,LEN(MES$)-INSTR(MES$,"VER.")-4)

'////////////////////////////////////////////////
@TITLE
PUSHKEY 65622 'CLEAR SOFT KEY
WHILE INKEY$()!="" WEND
UCLS
UHEAD UVER$
UBIG 30,"SELECT ACTION",UCW%
IF ONEREP%>=0 THEN
 IF ONELAT%>=0 THEN UT 12,52,"LAST FILE: PACKETS REPAIRED: "+STR$(ONEREP%)+", LATE: "+STR$(ONELAT%),UCK% ELSE UT 12,52,"LAST FILE: PACKETS REPAIRED: "+STR$(ONEREP%),UCK%
 ONEREP%=-1:ONELAT%=-1
ENDIF
FREEMEM OUT CM%,TM%
UT 12,184,"PETIT4SEND BY REI SOFTWARE, EDITED BY LTLAPY",UCG%
UT 12,196,"PETITCOM "+STR$(#VERSION DIV 1000000)+"."+STR$((#VERSION DIV 10000) MOD 100)+"."+STR$((#VERSION DIV 100) MOD 100)+"   FREE MEMORY "+UN$(TM%),UCG%
UFOOT "[A] SELECT",""
RESIZE ML$,0:RESIZE UI$,0
PUSH ML$,"DETECT SYNC KEY":PUSH UI$,"FIND SYNC KEY FOR FAST TRANSFER"
PUSH ML$,"USB RECEIVE":PUSH UI$,"RECEIVE FILE OR ARCHIVE FROM FLIPPER"
PUSH ML$,"SCREENSHOT SEND":PUSH UI$,"SEND FILE TO PC AS SCREENSHOTS"
PUSH ML$,"EXIT":PUSH UI$,"QUIT P4SENDX"
RESIZE UR$,0:RESIZE UD$,0
ACTION%=USEL(ML$,UR$,UD$,UI$,76,20,136,162,ACTION%)
IF ACTION%==0 THEN GOTO @SYNCKEY
IF ACTION%==1 THEN GOTO @USBRECEIVE
IF ACTION%==2 THEN GOTO @SCREENSHOT
ACLS
END

'////////////////////////////////////////////////
@SYNCKEY
UCLS
UHEAD "DETECT SYNC KEY"
UBIG 30,"DETECTING",UCK%
UT 12,52,"ON FLIPPER: SELECT DETECT, THEN RUN.",UCL%
UT 12,74,"DETECTIONS",UCL%
FOR I%=0 TO 24
 GFILL 12+I%*15,125,24+I%*15,126,UCG%
 IF I% MOD 6==0 THEN UT 12+I%*15,130,STR$(I%),UCL%
NEXT
UFOOT "[B] BACK",""

SK%=-1
SKT%=ARRAY%(25)
SB%=ARRAY%(0)
LOOP
 VSYNC
 IF BUTTON(0,#B_RDOWN,2) THEN
  IF SK%>=0 THEN USK%=SK%
  GOTO @TITLE
 ENDIF
 IF SK%>=0 && BUTTON(0,#B_RRIGHT,2) THEN
  USK%=SK%
  GOTO @USBRECEIVE
 ENDIF
 B%=-1
 FOR I%=0 TO 24
  IF KEYBOARD(I%+4) THEN B%=I%
 NEXT
 IF B%==-1 THEN SB%=ARRAY%(0):CONTINUE
 PUSH SB%,B%
 IF LEN(SB%)<12 THEN CONTINUE
 SORT SB%
 SK0%=-1
 FOR I%=0 TO 10
  IF SB%[I%]+3==SB%[I%+1] THEN SK0%=(SB%[I%]+6) MOD 25:BREAK
 NEXT
 IF SK0%<0 THEN SK0%=(SB%[0]+3)MOD 25
 SB%=ARRAY%(0)
 IF SK0%>=0 THEN INC SKT%[SK0%]
 J%=10:I%=SK%:SK%=-1
 FOR K%=0 TO 24
   IF J%<SKT%[K%] THEN J%=SKT%[K%]:SK%=K%
 NEXT
 'ONE KEY'S COLUMN, AND TWO MORE WHEN THE LEADER CHANGES
 UHIST SK0%
 IF SK%!=I% THEN
  IF I%>=0 THEN UHIST I%
  IF SK%>=0 THEN
   UHIST SK%
   UCLR 12,150,23,16
   UBIG 150,"SYNC KEY: "+STR$(SK%),UCK%
   UCLR 12,172,47,8
   UT 12,172,"STOP FLIPPER, SELECT KEY "+STR$(SK%)+", THEN PRESS A.",UCL%
   UFOOT "[B] BACK","[A] USB RECEIVE"
  ENDIF
 ENDIF
ENDLOOP

'////////////////////////////////////////////////
@USBRECEIVE
XM%=0
WARNSLEEP
BFORCE%=0
BREP%=0:BLATE%=0:BMIS%=0:BSEEN%=0:URT%=0:UTRYK%=-1:UFULL%=0:UEND%=0:UGAP%=0:UTF%=0:UTB%=0:UALLP%=0
FILL UBP%,0:FILL UBM%,0:FILL UBG%,0:FILL UBF%,0
USI%=0:USE%=0:USM%=0:USG%=0:USF%=0:UCP%=0:UCM%=0:UCGR%=0:UCGF%=0:UAF%=0:UACT%=0:USIG%=-1:USUP%=0
GOTO @BMENU

'ONE FILE HAS ARRIVED, ALL BUT SAVED
@ONEFILE
'DECOMPRESS
CASE COMP%
WHEN 1
 USTAGE "DECOMPRESSING"
 UBARNEW
 'MAKE 32BIT ARRAY
 RZC32%=ARRAY%(0)
 WHILE LEN(RZC%)MOD 4>0:PUSH RZC%,0:WEND
 FOR I%=0 TO LEN(RZC%)-1 STEP 4
  D%=    RZC%[I%  ]
  D%=D%+(RZC%[I%+1]<< 8)
  D%=D%+(RZC%[I%+2]<<16)
  D%=D%+(RZC%[I%+3]<<24)
  PUSH RZC32%,D%
 NEXT
 RFC%=ARRAY%(0)
 UNLZ RZC32%,0,RFC%,10,5,8,1
 CLS
OTHERWISE
 RFC%=RZC%
ENDCASE
'SIZE CHECK
IF FILELEN%>LEN(RFC%) THEN
 UBADFILE "SIZE DOES NOT MATCH"
 BGMPLAY 129
 LOOP
  VSYNC
  IF BUTTON(0,#B_RRIGHT,1) THEN BREAK
  IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
 ENDLOOP
ENDIF
RESIZE RFC%,FILELEN%
USTAGE "CHECKING"
'CRC CHECK
CRC%=&HFFFF
FOR I%=0 TO FILELEN%-1
 CRC%=CALC_CRC(CRC%,CRCTBL%,RFC%[I%])
NEXT
CRC%=CRC% XOR &HFFFF
IF CRC%!=FILECRC% THEN
 UBADFILE "CRC DOES NOT MATCH"
 BGMPLAY 129
 LOOP
  VSYNC
  IF BUTTON(0,#B_RRIGHT,1) THEN BREAK
  IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
 ENDLOOP
ENDIF
'SAVE
USTAGE "SAVING"
CASE MID$(FILENAME$,0,4)
WHEN "TXT:"
 FT$=""
 WHILE LEN(RFC%)MOD 2!=0:PUSH RFC%,0:WEND
 FOR I%=0 TO LEN(RFC%)-1 STEP 2
  PUSH FT$,CHR$(RFC%[I%]+(RFC%[I%+1]<<8))
 NEXT
 SAVEV FILENAME$,FT$
WHEN "GRP:"
 FG%=ARRAY%(GRPH%,GRPW%)
 X%=0:Y%=0
 WHILE LEN(RFC%)MOD 4!=0:PUSH RFC%,0:WEND
 FOR I%=0 TO LEN(RFC%)-1 STEP 4
  FG%[Y%,X%]=RFC%[I%]+(RFC%[I%+1]<<8)+(RFC%[I%+2]<<16)+(RFC%[I%+3]<<24)
  X%=X%+1:IF X%>=GRPW% THEN X%=0:Y%=Y%+1
 NEXT
 'THE PICTURE ALONE ON THE PAGE, AS IT IS SAVED. THE WORDS ARE ON THE CONSOLE
 GCLS
 GLOAD 0,0,GRPW%,GRPH%,FG%,0
 LOCATE 0,29:PRINT "PRESS ANY BUTTON TO SAVE";
 WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
 WHILE BUTTON(0,-1,0)==0:VSYNC:WEND
 CLS
 SAVEG FILENAME$,GTARGET(),0,0,GRPW%,GRPH%
 UCLS
WHEN "DAT:"
 FI%=ARRAY%(0)
 WHILE LEN(RFC%)MOD 4!=0:PUSH RFC%,0:WEND
 FOR I%=0 TO LEN(RFC%)-1 STEP 4
  PUSH FI%, RFC%[I%]+(RFC%[I%+1]<<8)+(RFC%[I%+2]<<16)+(RFC%[I%+3]<<24)
 NEXT
 SAVEV FILENAME$,FI%
OTHERWISE
 UT 12,200,"UNKNOWN TYPE",UCY%
 SAVEV FILENAME$,RFC%
ENDCASE
BGMPLAY 128
GOTO @TITLE

END

'////////////////////////////////////////////////
@RECEIVE
'WAIT UPDATE
VSYNC
'CHECK CLOCK
KEYBOARD 4 OUT DUMMY%,MK%
IF XDI%<XDN% THEN GOSUB @XDRAIN
IF MK% == BMK% THEN
 IF XH% THEN GOSUB @XHOLD
 RETURN
ENDIF
LASTPK%=MAINCNT()
IF XM% THEN GOSUB @XPACKET:RETURN
'READ KEY
FOR I%=0 TO 194
 IF KEYBOARD(KEYCODE%[I%]) THEN PUSH VK%,I%
NEXT
'MORE KEYS THAN ONE KEYBOARD HOLDS: AN NS LINK, FROM HERE ON
IF LEN(VK%)>6 THEN
 VK%=ARRAY%(0)
 XM%=1
 GOSUB @XPACKET
 RETURN
ENDIF
MB%=MBUTTON()
'CHECK AND UPDATE CLOCK
BMK%=MK%
CLK%=(MK% AND 3)
IF PG%>0 THEN
 'PACKETS THE CLOCK SAYS WERE LOST, EACH IN ITS PLACE IN THE GROUP
 PD%=(CLK%-BCLK%) AND 3
 WHILE PD%>0
  GOSUB @PMISS
  DEC PD%
 WEND
ELSEIF BCLK%!=CLK% THEN
 INC LOSTP%
 IF STATE%>=2 THEN
  PD%=(CLK%-BCLK%) AND 3
  INC UCM%,PD%:INC UCP%,PD%
 ENDIF
ENDIF
BCLK%=(CLK%+1)AND 3
'CHECK KEY
IF LEN(VK%)!=6 THEN
 IF PG%>0 THEN
  GOSUB @PMISS
 ELSE
  INC LOSTP%
  IF STATE%>=2 THEN INC UCM%:INC UCP%
 ENDIF
 VK%=ARRAY%(0)
 RETURN
ENDIF
'MAKE HASH VALUE
SORT VK%
D#=   VK%[0]
D#=D#+VK%[1]*(VK%[1]-1)/2
D#=D#+VK%[2]*(VK%[2]-1)/2*(VK%[2]-2)/3
D#=D#+VK%[3]*(VK%[3]-1)/2*(VK%[3]-2)/3*(VK%[3]-3)/4
D#=D#+VK%[4]*(VK%[4]-1)/2*(VK%[4]-2)/3*(VK%[4]-3)/4*(VK%[4]-4)/5
D#=D#+VK%[5]*(VK%[5]-1)/2*(VK%[5]-2)/3*(VK%[5]-3)/4*(VK%[5]-4)/5*(VK%[5]-5)/6
IF (MK% AND 8)>0 THEN D#=D#+68719476736
VK%=ARRAY%(0)
'D#: 37BIT VALUE
'RBUF/RBIT 0-7BIT VALUE
DH%=INT(D#/65536) 'UPPER21BIT
DL%=INT(D#-DH%*65536.0) 'LOWER16BIT
IF STATE%>=2 THEN INC UCP%
IF PG%>0 THEN
 'A PACKET OF A GROUP WAITS TILL THE GROUP'S END. AN EVEN ONE HAS NO MOUSE BITS
 GL%[PI%]=DL%:GH%[PI%]=DH%
 PM%=0
 IF (PI% AND 1)==1 THEN PM%=MB% AND 31
 GM%[PI%]=PM%
 PAL%=PAL% XOR DL%:PAH%=PAH% XOR DH%:PAM%=PAM% XOR PM%
 INC PI%
 IF PI%>=PG% THEN GOSUB @PGROUP
 RETURN
ENDIF
IF (CLK% AND 1)==1 THEN
 RBUF%=RBUF% OR ((MB% AND 31)<<RBIT%):RBIT%=RBIT%+5
ENDIF
RBUF%=RBUF% OR (DL%<<RBIT%):RBIT%=RBIT%+16
WHILE RBIT%>7
 PUSH REC%, RBUF% AND &HFF
 RBUF%=RBUF%>>8:RBIT%=RBIT%-8
WEND
RBUF%=RBUF% OR (DH%<<RBIT%):RBIT%=RBIT%+21
WHILE RBIT%>7
 PUSH REC%, RBUF% AND &HFF
 RBUF%=RBUF%>>8:RBIT%=RBIT%-8
WEND
RETURN

'A PACKET OF THE GROUP IS MISSING HERE
@PMISS
INC UCM%:INC UCP%
INC PN%
PX%=PI%
INC PI%
IF PI%>=PG% THEN GOSUB @PGROUP
RETURN

'A WHOLE GROUP: THE XOR OF ALL ITS PACKETS IS ZERO, OR IS THE ONE MISSING.
'ITS BITS GO ON IN THE ORDER OF THE STREAM. THE PARITY PACKET HOLDS NONE.
@PGROUP
UG%=1
INC UCGR%
IF PN%>=2 THEN
 INC UCGF%
 UPFAIL%=PN%
 INC LOSTP%
ELSE
 IF PN%==1 THEN
  GL%[PX%]=PAL%:GH%[PX%]=PAH%:GM%[PX%]=PAM%
  INC REP%:INC BREP%
 ELSEIF (PAL% OR PAH% OR PAM%)!=0 THEN
  'A PACKET WAS MISREAD. THE CRC DECIDES
  INC BMIS%
 ENDIF
 FOR PJ%=0 TO PG%-2
  IF (PJ% AND 1)==1 THEN
   RBUF%=RBUF% OR (GM%[PJ%]<<RBIT%):RBIT%=RBIT%+5
  ENDIF
  RBUF%=RBUF% OR (GL%[PJ%]<<RBIT%):RBIT%=RBIT%+16
  WHILE RBIT%>7
   PUSH REC%, RBUF% AND &HFF
   RBUF%=RBUF%>>8:RBIT%=RBIT%-8
  WEND
  RBUF%=RBUF% OR (GH%[PJ%]<<RBIT%):RBIT%=RBIT%+21
  WHILE RBIT%>7
   PUSH REC%, RBUF% AND &HFF
   RBUF%=RBUF%>>8:RBIT%=RBIT%-8
  WEND
 NEXT
ENDIF
PI%=0:PN%=0:PAL%=0:PAH%=0:PAM%=0
RETURN

'AN NS LINK: KEYS IN ORDER, SO NO SORT, AND NO ARRAYS GROW. 6 KEYS ON EACH KEYBOARD
'OR A MINUS IN XV%. BEFORE A LEAD SAYS HOW MANY KEYBOARDS, THE 7TH MAY BE EMPTY
@XREAD
XT%=0:XOK%=1:XQ%=0
IF PG%>0 THEN XN%=XB% ELSE XN%=7
FOR XJ%=0 TO XN%-1
 XR%=0:XS%=0
 FOR XK%=0 TO 26
  IF KEYBOARD(KX%[XQ%]) THEN
   IF XS%<6 THEN INC XR%,XC%[XS%*27+XK%]
   INC XS%
  ENDIF
  INC XQ%
 NEXT
 INC XT%,XS%
 IF XS%!=6 || XR%>#X_SAME THEN
  IF PG%>0 || XJ%<6 || XS%>0 THEN XOK%=0:XR%=-1
 ENDIF
 XV%[XJ%]=XR%
NEXT
RETURN

'A NEW CLOCK. THE KEYS CAN COME A FRAME AFTER IT, ON ANOTHER KEYBOARD: NO KEYBOARD SHOWS THE
'SAME KEYS TWICE, SO SAME KEYS ARE KEYS NOT YET HERE, AND THE PACKET WAITS FOR THEM
@XPACKET
IF XH% THEN XH%=0:GOSUB @XMISS
BMK%=MK%
CLK%=(MK% AND 3)
PD%=(CLK%-BCLK%) AND 3
BCLK%=(CLK%+1)AND 3
XCK%=(PD%==0 && !XNC%)
XNC%=0
GOSUB @XREAD
IF XOK% && XV%[0]==#X_MARK && XV%[3]==0 && XV%[4]==0 && XV%[5]==0 && XV%[6]==0 THEN
 'A LEAD PACKET. THE STREAM STARTS WITH ANY OF THEM
 XR%=XV%[2]>>8
 IF XV%[1]<4 || XV%[1]>64 || (XV%[1] AND 1)!=0 || (XR%!=6 && XR%!=7) THEN RETURN
 COPY XLC%,XV%:COPY XLV%,XV%
 XS%=XV%[2] AND 255
 IF XSKIP%>0 && PG%==XV%[1] THEN XSKIP%=XS%:RETURN
 PG%=XV%[1]:XSKIP%=XS%:XB%=XR%
 IF LEN(GV%)!=PG%*7 THEN GV%=ARRAY%(PG%*7)
 PI%=0:PN%=0:FILL PA%,0
 XDI%=0:XDN%=0
 REC%=ARRAY%(0)
 RBUF%=0:RBIT%=0
 LOSTP%=0
 BALARM%=0
 STATE%=2
 USPN%=0:UFR0%=MAINCNT()
 IF UTF%==0 THEN UTF%=MAINCNT()
 IF UEND%>0 THEN UGAP%=(MAINCNT()-UEND%) DIV 60:UEND%=0
 REP%=0:XLATE%=0
 RETURN
ENDIF
IF PG%==0 THEN
 '1 TO 6 KEYS WITH NOTHING GOING ON: ONE KEYBOARD AGAIN. THE REST OF A FAILED STREAM IS NOT IT
 IF XT%>0 && XT%<=6 THEN XM%=0
 RETURN
ENDIF
WHILE PD%>0
 IF XSKIP%>0 THEN DEC XSKIP% ELSE GOSUB @XMISS
 DEC PD%
WEND
IF XSKIP%>0 THEN DEC XSKIP%:XNC%=1:RETURN
IF XT%==0 THEN GOSUB @XMISS:RETURN
XST%=!XOK%
IF XCK% THEN
 FOR XJ%=1 TO XN%-1
  IF XV%[XJ%]==XLC%[XJ%] THEN XST%=1
 NEXT
ENDIF
IF XST% THEN
 COPY XHV%,XV%
 XH%=1:XHC%=XCK%
 RETURN
ENDIF
GOSUB @XTAKE
RETURN

'THE CLOCK IS THE SAME AS LAST FRAME AND THE PACKET WAS NOT WHOLE. A KEYBOARD THAT WAS RIGHT
'AND HAS CHANGED SHOWS THE NEXT PACKET: THIS ONE WILL NOT BE WHOLE
@XHOLD
GOSUB @XREAD
FOR XJ%=0 TO XN%-1
 IF XHV%[XJ%]>=0 && (XJ%==0 || !XHC% || XHV%[XJ%]!=XLC%[XJ%]) && XV%[XJ%]!=XHV%[XJ%] THEN
  XH%=0
  GOSUB @XMISS
  RETURN
 ENDIF
NEXT
IF !XOK% THEN RETURN
IF XHC% THEN
 FOR XJ%=1 TO XN%-1
  IF XV%[XJ%]==XLC%[XJ%] THEN RETURN
 NEXT
ENDIF
XH%=0
INC XLATE%:INC BLATE%
GOSUB @XTAKE
RETURN

'A WHOLE PACKET. THE SAME CODE MEANS THE VALUE BEFORE. EACH PLACE HAS ITS MASK
@XTAKE
INC UCP%
'THE LAST GROUP'S BITS MUST HAVE GONE ON FROM THE PLACE THIS PACKET TAKES
WHILE XDI%<XDN% && XDI%<=PI%
 GOSUB @XDRAIN
WEND
XQ%=(PI%+1)*40503
FOR XJ%=0 TO XN%-1
 XR%=XV%[XJ%]
 XLC%[XJ%]=XR%
 IF XR%==#X_SAME THEN XR%=XLV%[XJ%]
 XLV%[XJ%]=XR%
 XR%=XR% XOR ((XQ%+(XJ%+1)*25931) AND 262143)
 XV%[XJ%]=XR%
 PA%[XJ%]=PA%[XJ%] XOR XR%
NEXT
COPY GV%,PI%*7,XV%,0,7
INC PI%
IF PI%>=PG% THEN GOSUB @XGROUP
RETURN

@XMISS
XNC%=1
INC UCM%:INC UCP%
INC PN%
PX%=PI%
INC PI%
IF PI%>=PG% THEN GOSUB @XGROUP
RETURN

'THE XOR OF ALL A GROUP'S PACKETS IS ZERO, OR IS THE ONE MISSING. THE BITS GO ON A LITTLE
'AT A TIME, AHEAD OF THE NEXT GROUP FILLING THE SAME PLACES
@XGROUP
UG%=1
INC UCGR%
IF PN%>=2 THEN
 INC UCGF%
 UPFAIL%=PN%
 INC LOSTP%
ELSE
 IF PN%==1 THEN
  COPY GV%,PX%*7,PA%,0,7
  INC REP%:INC BREP%
 ELSE
  XOK%=0
  FOR XJ%=0 TO XB%-1
   IF PA%[XJ%]!=0 THEN XOK%=1
  NEXT
  'A PACKET WAS MISREAD. THE CRC DECIDES
  IF XOK% THEN INC BMIS%
 ENDIF
 XDI%=0:XDN%=PG%-1
ENDIF
PI%=0:PN%=0:FILL PA%,0
RETURN

@XDRAIN
FOR XP%=1 TO 2
 IF XDI%>=XDN% THEN BREAK
 XQ%=XDI%*7
 FOR XJ%=0 TO XB%-1
  RBUF%=RBUF% OR (GV%[XQ%+XJ%]<<RBIT%):RBIT%=RBIT%+18
  WHILE RBIT%>7
   PUSH REC%, RBUF% AND &HFF
   RBUF%=RBUF%>>8:RBIT%=RBIT%-8
  WEND
 NEXT
 INC XDI%
NEXT
RETURN

'////////////////////////////////////////////////
'USB RECEIVE, FOR ONE FILE OR THE PARTS OF AN ARCHIVE (NOT IN PETIT4SEND 1.2.2)
'A STREAM NAMED DAT:P4A00000 AND SO ON IS A PART. PARTS ARE SAVED ONE BY ONE,
'THEN BECOME THE FILES. NOTHING THEY GO THROUGH MAY ANSWER TO ENTER, THE
'FLIPPER IS TAPPING IT FOR THE SAVE DIALOGS.
@BMENU
UCLS
UHEAD "USB RECEIVE"
BSCAN
IF !BFORCE% && BNB%==0 && BNG%<=1 THEN
 BCUR%=BNG%-1
 GOTO @BUSE
ENDIF
BFORCE%=0
IF BNG%==0 && BNB%==0 THEN @TITLE

UCLS
UHEAD "USB RECEIVE"
UBIG 30,"UNFINISHED TRANSFERS",UCW%
UT 12,52,NARCH$(BNG%)+" IN THIS PROJECT",UCL%
UFOOT "[A] SELECT",""
RESIZE ML$,0:RESIZE UR$,0:RESIZE UD$,0:RESIZE UI$,0
FOR BI%=0 TO BNG%-1
 BN$=HEXID$(BGID%[BI%])
 PUSH ML$,"RESUME "+BN$:PUSH UR$,STR$(BGN%[BI%])+" OF "+STR$(BGC%[BI%]):PUSH UD$,UCELLS$(BI%)
 PUSH ML$,"DELETE "+BN$:PUSH UR$,"":PUSH UD$,""
NEXT
IF BNB%>0 THEN PUSH ML$,"DELETE "+STR$(BNB%)+" UNREADABLE FILES":PUSH UR$,"":PUSH UD$,""
PUSH ML$,"BACK":PUSH UR$,"":PUSH UD$,""
'ENTER TAPPED AT THE SAVE DIALOGS MAY STILL BE QUEUED
WHILE INKEY$()!="" WEND
BI%=USEL(ML$,UR$,UD$,UI$,76,24,198,0,0)
IF BI%<0 || BI%==LEN(ML$)-1 THEN @TITLE
IF BI%<BNG%*2 && (BI% AND 1)==0 THEN
 BCUR%=BI% DIV 2
 GOTO @BUSE
ENDIF
'DELETE ASKS FOR A CONTROLLER BUTTON:
'DATA PACKETS HOLD KEYS THAT COULD WORK THIS MENU
IF BI%<BNG%*2 THEN BCUR%=BI% DIV 2 ELSE BCUR%=-1
UCLS
UHEAD "UNFINISHED TRANSFERS"
IF BCUR%>=0 THEN
 UBIG 30,"DELETE "+STR$(BGN%[BCUR%])+" PARTS?",UCY%
 UT 12,52,"ARCHIVE "+HEXID$(BGID%[BCUR%]),UCL%
 UT 12,70,"PARTS",UCL%:UTR 70,STR$(BGN%[BCUR%])+" OF "+STR$(BGC%[BCUR%]),UCW%
 UMINI 12,80,376,12,UCELLS$(BCUR%)
ELSE
 UBIG 30,"DELETE "+STR$(BNB%)+" FILES?",UCY%
 UT 12,52,"UNREADABLE PARTS",UCL%
ENDIF
UT 12,108,"ALL PROGRESS WILL BE LOST.",UCY%
UT 12,128,"USE CONTROLLER TO CONFIRM:",UCW%
UT 28,144,"[B] KEEP",UCW%
UT 28,158,"[X] DELETE",UCW%
UFOOT "[B] GO BACK",""
WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
LOOP
 VSYNC
 IF BUTTON(0,#B_RUP,1) THEN BREAK
 IF BUTTON(0,#B_RDOWN,1) THEN BFORCE%=1:GOTO @BMENU
ENDLOOP
FOR BI%=0 TO LEN(BPF$)-1
 IF BPF$[BI%]!="" && BPG%[BI%]==BCUR% THEN
  DELETE BPF$[BI%]
 ENDIF
NEXT
BFORCE%=0
GOTO @BMENU

@BUSE
ARSET%=0:ARID%=0:ARN%=0:BHAVE%=ARRAY%(1):URN%=0
IF BCUR%>=0 THEN
 ARSET%=1:ARID%=BGID%[BCUR%]:ARN%=BGC%[BCUR%]
 BHAVE%=ARRAY%(ARN%)
 FOR BI%=0 TO LEN(BPF$)-1
  IF BPF$[BI%]!="" && BPG%[BI%]==BCUR% THEN
   BHAVE%[VAL(MID$(BPF$[BI%],7,5))]=1
  ENDIF
 NEXT
ENDIF
BNEED%=0
IF ARSET% THEN WHILE BNEED%<ARN% && BHAVE%[BNEED%]:INC BNEED%:WEND
IF ARSET% THEN URN%=ARN%:UFP%=ARRAY%(ARN%)
IF ARSET% && BNEED%>=ARN% THEN
 UCLS
 UHEAD "USB RECEIVE"
 IF ARN%<1000 THEN UBIG 30,"ALL "+STR$(ARN%)+" PARTS RECEIVED",UCK% ELSE UBIG 30,"ALL PARTS RECEIVED",UCK%
 UT 12,52,"ARCHIVE "+HEXID$(ARID%),UCL%
 UT 12,70,"PARTS",UCL%:UTR 70,STR$(ARN%)+" OF "+STR$(ARN%),UCW%
 UPARTS
 UBIG 116,"WRITE FILES?",UCW%
 UFOOT "[A] WRITE  [B] BACK","[X] UNFINISHED TRANSFERS"
 WHILE INKEY$()!="" WEND
 LOOP
  VSYNC
  IF BUTTON(0,#B_RRIGHT,1) || INKEY$()==CHR$(13) THEN GOTO @BWRITE
  IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
  IF BUTTON(0,#B_RUP,1) THEN BFORCE%=1:GOTO @BMENU
 ENDLOOP
ENDIF

UWAIT
PUSHKEY 65622 'CLEAR SOFT KEY

@BSTREAM
PG%=0:XH%=0
XDI%=0:XDN%=0:XSKIP%=0
STATE%=0
REC%=ARRAY%(0)
RBUF%=0:RBIT%=0
UMODE%=0
ULAST%=MAINCNT()
LOOP
 GOSUB @RECEIVE
 IF MAINCNT()>=UNX% THEN GOSUB @UTICK
 IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
 IF STATE%<2 && ARSET% && BUTTON(0,#B_RUP,1) THEN BFORCE%=1:GOTO @BMENU
 'ONE FILE GOES ON THROUGH THESE, AND ITS CRC TELLS
 IF STATE%>=2 && STATE%<=8 THEN
  IF LOSTP%>0 && PG%>0 THEN BLOSS UMISS$(UPFAIL%):GOTO @BSTREAM
  IF LOSTP%>0 THEN BLOSS UMISS$(LOSTP%):GOTO @BSTREAM
  IF MAINCNT()-LASTPK%>180 THEN BLOSS "STREAM STOPPED":GOTO @BSTREAM
 ENDIF
 'ONE FILE WITH PARITY: WHAT THE GROUPS CANNOT REPAIR IS SENT AGAIN
 IF STATE%>=9 && PG%>0 THEN
  IF LOSTP%>0 THEN BAGAIN UPFAIL%:GOTO @BSTREAM
  IF MAINCNT()-LASTPK%>180 THEN BAGAIN -1:GOTO @BSTREAM
 ENDIF
 CASE STATE%
 WHEN 0
  'DETECT START
  IF BALARM% THEN
   IF BUTTON(0,-1,0)!=0 THEN
    BALARM%=0
   ELSEIF MAINCNT()>=BALARMAT% THEN
    BGMPLAY 129
    BALARMAT%=MAINCNT()+BALARMGAP%
   ENDIF
  ENDIF
  IF LEN(REC%)<=0 THEN CONTINUE
  WHILE LEN(REC%)>0
   B%=REC%[0]
   IF B%!=0 THEN BREAK
   B%=SHIFT(REC%)
  WEND
  IF B%==0 THEN CONTINUE
  BONES%=0
  STATE%=1
 WHEN 1
  'SYNC BUFFER POS
  IF LEN(REC%)<=0 THEN CONTINUE
  WHILE LEN(REC%)>0
   B%=SHIFT(REC%)
   IF B%==0 THEN BREAK
   IF B%==1 THEN INC BONES%:CONTINUE
   'SYNC
   RBIT%=0:RBUF%=0:BONES%=0
   REC%=ARRAY%(0)
   BREAK
  WEND
  IF B%!=0 THEN CONTINUE
  'DATA CAN HOLD A ZERO TOO: THE LEADER IS A RUN OF ONES
  IF BONES%<4 THEN STATE%=0:CONTINUE
  LOSTP%=0
  LASTPK%=MAINCNT()
  BALARM%=0
  STATE%=2
  USPN%=0:UFR0%=MAINCNT()
  IF UTF%==0 THEN UTF%=MAINCNT()
  IF UEND%>0 THEN UGAP%=(MAINCNT()-UEND%) DIV 60:UEND%=0
  'A NAME STARTS WITH A LETTER. HERE IS THE SIZE OF PARITY GROUPS INSTEAD: THE LAST
  'BITS OF THIS PACKET ARE PADDING AND THE NEXT ONE STARTS THE FIRST GROUP
  IF LEN(REC%)>0 THEN
   B%=REC%[0]
   IF B%>=4 && B%<=64 && (B% AND 1)==0 THEN
    PG%=B%
    GL%=ARRAY%(PG%):GH%=ARRAY%(PG%):GM%=ARRAY%(PG%)
    PI%=0:PN%=0:PAL%=0:PAH%=0:PAM%=0
    REC%=ARRAY%(0)
    RBUF%=0:RBIT%=0
   ENDIF
  ENDIF
  REP%=0
 WHEN 2
  'TYPE+NAME 36, LENGTH 4, GRP SIZE 4, COMPRESS 1, TRANSFER LENGTH 4
  IF LEN(REC%)<49 THEN CONTINUE
  FILENAME$=""
  FOR BI%=0 TO 35
   IF REC%[BI%]==0 THEN BREAK
   FILENAME$=FILENAME$+CHR$(REC%[BI%])
  NEXT
  FILELEN%=REC%[36]+(REC%[37]<<8)+(REC%[38]<<16)+(REC%[39]<<24)
  GRPW%=REC%[40]+(REC%[41]<<8)
  GRPH%=REC%[42]+(REC%[43]<<8)
  COMP%=REC%[44]
  RTLEN%=REC%[45]+(REC%[46]<<8)+(REC%[47]<<16)+(REC%[48]<<24)
  FOR BI%=0 TO 48:B%=SHIFT(REC%):NEXT
  BK%=PARTNO(FILENAME$)
  IF BK%<0 THEN
'NOT A PART: ONE FILE. SAVED PARTS STAY AS THEY ARE
   UPG#=#U_ONEFILE
   UONEFILE
   RZC%=ARRAY%(0):RFC%=ARRAY%(0)
   STATE%=9
   CONTINUE
  ENDIF
  IF FILELEN%<12 || FILELEN%>16777228 || (FILELEN% AND 3)!=0 THEN
   BFAIL "INVALID HEADER"
   GOTO @BSTREAM
  ENDIF
  'THE ARCHIVE WAS COMPRESSED BEFORE IT WAS SPLIT: PARTS ARE PLAIN BYTES
  IF COMP%!=0 || RTLEN%!=FILELEN% THEN
   BFAIL "INVALID HEADER (OLD P4PACK?)"
   GOTO @BSTREAM
  ENDIF
  BI%=FILELEN% DIV 4
  IF LEN(RB%)!=BI% THEN RB%=ARRAY%(BI%)
  RP%=0:RW%=0:OP%=0:BAD%=0:CRC%=&HFFFF
  'A GOOD HEADER: WHATEVER WAS ASKED FOR HAS BEEN DONE
  BALARM%=0
  UPG#=RTLEN%+51
  URECV
  STATE%=7
 WHEN 7
  'FILE CONTENTS. CHECKED AS THEY COME, SO THAT THE SAVE DIALOG NEED NOT
  'WAIT FOR ANY OF IT
  WHILE LEN(REC%)>0 && RP%<RTLEN%
   B%=SHIFT(REC%)
   INC RP%
   GOSUB @BOUT
  WEND
  IF RP%>=RTLEN% THEN STATE%=8
 WHEN 8
  'FILE CRC
  IF LEN(REC%)<2 THEN CONTINUE
  FILECRC%=SHIFT(REC%)
  FILECRC%=FILECRC%+(SHIFT(REC%)<<8)
  BREAK
 WHEN 9
  'ONE FILE'S CONTENTS
  IF LEN(REC%)<=0 && RTLEN%>0 THEN CONTINUE
  WHILE LEN(REC%)>0 && LEN(RZC%)<RTLEN%
   PUSH RZC%,SHIFT(REC%)
  WEND
  IF LEN(RZC%)>=RTLEN% THEN STATE%=10
 WHEN 10
  'ONE FILE'S CRC
  IF LEN(REC%)<2 THEN CONTINUE
  FILECRC%=SHIFT(REC%)
  FILECRC%=FILECRC%+(SHIFT(REC%)<<8)
  UTICKFILE
  UMODE%=0
  'THE STREAM'S LAST PACKETS MUST PASS BEFORE ANY DIALOG
  IF PG%>0 THEN VSYNC 12:ONEREP%=REP%
  IF PG%>0 && XM% THEN ONELAT%=XLATE%
  PG%=0
  XDI%=0:XDN%=0
  GOTO @ONEFILE
 ENDCASE
ENDLOOP

'LET THE STREAM'S LAST PACKETS PASS (7 AT 24 MS): A AND B ARE HELD IN THEM
VSYNC 12
BUF%=RB%
BR%=(BAD%==0 && OP%==FILELEN% && (CRC% XOR &HFFFF)==FILECRC%)
UMODE%=0
IF !BR% THEN
 IF BK%<BNEED% THEN BDROPPED:GOTO @BSTREAM
 BFAIL "CRC DOES NOT MATCH"
 GOTO @BSTREAM
ENDIF
IF BUF%[1]!=BK% || BUF%[2]<=BK% THEN
 BFAIL "WRONG PREFIX"
 GOTO @BSTREAM
ENDIF
IF ARSET% && BUF%[0]!=ARID% THEN
 UOTHER HEXID$(BUF%[0])
 GOTO @BSTREAM
ENDIF
IF BK%!=BNEED% THEN
 IF BK%<BNEED% THEN BDROPPED ELSE UFAIL "PART "+STR$(BK%)+" IGNORED","NEED PART "+STR$(BNEED%):BALERT
 GOTO @BSTREAM
ENDIF
IF BK%==0 THEN
 IF LEN(BUF%)<7 THEN BFAIL "NOT START OF ARCHIVE":GOTO @BSTREAM
 IF BUF%[3]==&H31413450 THEN
  UOLD
  GOTO @BSTREAM
 ENDIF
 IF BUF%[3]!=&H33413450 || BUF%[4]!=BUF%[0] THEN BFAIL "NOT START OF ARCHIVE":GOTO @BSTREAM
ENDIF
IF ARSET% && BUF%[2]!=ARN% THEN
 BFAIL "WRONG PREFIX"
 GOTO @BSTREAM
ENDIF
USAVING
BN$="DAT:P4A"+FORMAT$("%05D",BK%)
SAVEV BN$,BUF%
BR%=RESULT()
IF BR%==-1 THEN BFAIL "SAVE CANCELLED":GOTO @BSTREAM
IF BR%!=1 THEN BFAIL "NOT SAVED":GOTO @BSTREAM
IF !ARSET% THEN
 ARSET%=1:ARID%=BUF%[0]:ARN%=BUF%[2]
 BHAVE%=ARRAY%(ARN%)
ENDIF
BHAVE%[BK%]=1
WHILE BNEED%<ARN% && BHAVE%[BNEED%]:INC BNEED%:WEND
BSEEN%=1
UEND%=MAINCNT()
IF RTLEN%>UFULL% THEN UFULL%=RTLEN%
INC UTB%,RTLEN%
IF URN%!=ARN% THEN URN%=ARN%:UFP%=ARRAY%(ARN%)
IF BK%<URN% THEN UFP%[BK%]=0
IF BNEED%<ARN% THEN UWAIT:GOTO @BSTREAM

'ALL PARTS ARE SAVED
@BWRITE
URN%=ARN%
UWRITING
UT 12,52,"CHECKING ARCHIVE",UCL%
RB%=ARRAY%(0):BUF%=ARRAY%(0)
BERR$=""
CRC32TBL%=CALC_CRC32TBL()
BC%=-1
FOR BP%=0 TO ARN%-1
 GOSUB @BPART
 IF BR%!=1 || LEN(BUF%)<3 THEN BERR$="CANNOT READ PART "+STR$(BP%):BREAK
 IF BUF%[0]!=ARID% || BUF%[1]!=BP% || BUF%[2]!=ARN% THEN BERR$="PART "+STR$(BP%)+" BELONGS TO ANOTHER ARCHIVE":BREAK
 IF BP%==0 THEN
  IF LEN(BUF%)<7 THEN BERR$="NOT AN ARCHIVE":BREAK
  IF BUF%[3]==&H31413450 THEN BERR$="OLD P4PACK: REBUILD IT WITH THE CURRENT ONE":BREAK
  IF BUF%[3]!=&H33413450 || BUF%[4]!=ARID% THEN BERR$="NOT AN ARCHIVE":BREAK
  BMETH%=BUF%[5]
  BIMGN%=BUF%[6]
  BC%=CRC32W(BC%,BUF%,CRC32TBL%,5)
 ELSE
  BC%=CRC32W(BC%,BUF%,CRC32TBL%,3)
 ENDIF
NEXT
IF BERR$=="" && (BC% XOR -1)!=ARID% THEN BERR$="CRC-32 DOES NOT MATCH THE ID"
IF BERR$=="" && BMETH%!=0 && BMETH%!=1 THEN BERR$="UNKNOWN METHOD "+STR$(BMETH%)
IF BERR$=="" && (BIMGN%<4 || (BIMGN% AND 3)!=0) THEN BERR$="INVALID IMAGE SIZE"
IF BERR$!="" THEN
 UCLS
 UHEAD "ARCHIVE "+HEXID$(ARID%)
 UBIG 30,"ARCHIVE CHECK FAILED",UCY%
 UT 12,52,BERR$,UCW%
 UT 12,70,"PARTS",UCL%:UTR 70,STR$(ARN%)+" OF "+STR$(ARN%),UCW%
 UPARTS
 UT 12,108,"NO FILES WRITTEN. PARTS KEPT.",UCW%
 UFOOT "STOP FLIPPER, THEN PRESS B.",""
 BGMPLAY 129
 GOTO @BEND
ENDIF

'THE ENTRIES, UNPACKED AS THEY ARE REACHED, ONE PART IN MEMORY AT A TIME
BOK%=0:BBAD%=0:BDL%=0
BFLN$=ARRAY$(4):BFLR$=ARRAY$(4)
BP%=0
GOSUB @BPART
BPOS%=7:ZP%=28:ZN%=LEN(BUF%)*4
BFX$=FILES()
BNS%=0:BST%=0:BSN%=0
BT0%=MILLISEC()
BIMG%=0:BTIME%=0:ZERR%=0:ZL%=0:ZFN%=0:RI%=0
IF BMETH%==1 THEN RG%=ARRAY%(65536)
FW%=ARRAY%(1)
BCNT%=1:BDST%=0
GOSUB @BREAD
BENT%=FW%[0]
IF BCNT%>0 || BENT%<0 || BENT%>(BIMGN%-4) DIV 44 THEN
 BLOG "ARCHIVE","INVALID ENTRY COUNT"
 BENT%=1
 GOTO @BWRITTEN
ENDIF
UFILES 0
FOR BE%=0 TO BENT%-1
 FW%=ARRAY%(11)
 BCNT%=11:BDST%=0
 GOSUB @BREAD
 IF BCNT%>0 THEN BLOG "?","ARCHIVE ENDS EARLY":BREAK
 BN$=""
 FOR BI%=0 TO 35
  B%=(FW%[BI%>>2]>>((BI% AND 3)*8)) AND 255
  IF B%==0 THEN BREAK
  BN$=BN$+CHR$(B%)
 NEXT
 BSIZE%=FW%[9]
 BCRC%=FW%[10] AND &HFFFF
 BW%=(BSIZE%+3) DIV 4
 IF BSIZE%<0 || BW%<0 || BW%>(BIMGN%-BIMG%) DIV 4 THEN BLOG BN$,"INVALID SIZE":BREAK
 FW%=ARRAY%(0)
 FREEMEM OUT CM%,TM%
 IF CM%<BW%*4+1024 THEN
  'THE DATA IS UNPACKED WITHOUT BEING HELD: WHAT COMES LATER NEEDS IT IN THE RING
  BLOG BN$,"NOT ENOUGH MEMORY"
  BPW%=BW%
  GOSUB @BPASS
  IF BCNT%>0 THEN BLOG BN$,"ARCHIVE ENDS EARLY":BREAK
  CONTINUE
 ENDIF
 FW%=ARRAY%(BW%)
 BCNT%=BW%:BDST%=0
 GOSUB @BREAD
 IF BCNT%>0 THEN BLOG BN$,"ARCHIVE ENDS EARLY":BREAK
 IF !GOODNAME(BN$) THEN BLOG BN$,"NAME NOT ALLOWED":CONTINUE
 IF CRCW(FW%,CRCTBL%,BSIZE%)!=BCRC% THEN BLOG BN$,"THE CRC DOES NOT MATCH":CONTINUE
 CASE MID$(BN$,0,4)
 WHEN "TXT:"
  GOSUB @BTEXT
 WHEN "GRP:"
  GRPW%=FW%[0] AND &HFFFF
  GRPH%=(FW%[0]>>16) AND &HFFFF
  IF GRPW%<1 || GRPW%>2048 || GRPH%<1 || GRPH%>2048 || BW%!=1+GRPW%*GRPH% THEN BLOG BN$,"INVALID IMAGE SIZE":CONTINUE
 ENDCASE
 GOSUB @BSAME
 UFILE BN$,BSIZE%,BSM%
 IF BSM% THEN
  INC BOK%:INC BNS%
  FT$=""
  UFILES BE%+1
  CONTINUE
 ENDIF
 CASE MID$(BN$,0,4)
 WHEN "TXT:"
  VSYNC:BS0%=MILLISEC()
  SAVEV BN$,FT$
  BR%=RESULT()
  INC BST%,MILLISEC()-BS0%
  FT$=""
 WHEN "GRP:"
  FG%=ARRAY%(GRPH%,GRPW%)
  COPY FG%,0,FW%,1,GRPW%*GRPH%
  'ON ITS OWN PAGE: THE SCREEN STAYS, AND IS NOT SAVED
  GTARGET 1
  GLOAD 0,0,GRPW%,GRPH%,FG%,0
  FG%=ARRAY%(0)
  VSYNC:BS0%=MILLISEC()
  SAVEG BN$,1,0,0,GRPW%,GRPH%
  BR%=RESULT()
  INC BST%,MILLISEC()-BS0%
  GCLS
  GTARGET 0
 WHEN "DAT:"
  VSYNC:BS0%=MILLISEC()
  SAVEV BN$,FW%
  BR%=RESULT()
  INC BST%,MILLISEC()-BS0%
 ENDCASE
 INC BSN%
 IF BR%==1 THEN
  INC BOK%
 ELSEIF BR%==-1 THEN
  BLOG BN$,"CANCELLED"
 ELSE
  BLOG BN$,"NOT WRITTEN"
 ENDIF
 UFILES BE%+1
NEXT
IF BIMG%!=BIMGN% || ZL%!=0 THEN BLOG "ARCHIVE","IMAGE SIZE DOES NOT MATCH"
@BWRITTEN
VSYNC
BTIME%=MILLISEC()-BT0%-BST%
FW%=ARRAY%(0):BUF%=ARRAY%(0):RG%=ARRAY%(0):BOLD=0
BFX$=ARRAY$(0)

'THE PARTS GO ONLY WHEN ALL THE FILES ARE WRITTEN:
'THEY ARE WHAT A RETRY NEEDS
IF BOK%==BENT% && BBAD%==0 THEN
 UCLR 12,52,47,8
 UT 12,52,"DELETING PARTS",UCL%
 FOR BP%=0 TO ARN%-1
  DELETE PARTNAME$(BP%)
  IF RESULT()==1 THEN INC BDL%
 NEXT
ENDIF
UDONESCREEN
IF BOK%==BENT% && BBAD%==0 THEN BGMPLAY 128 ELSE BGMPLAY 129

@BEND
WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
WHILE !BUTTON(0,#B_RDOWN,1):VSYNC:WEND
GOTO @TITLE

'PART BP% INTO BUF%. BR% IS 1 IF THAT WORKED
@BPART
BUF%=LOADV(PARTNAME$(BP%)):BR%=RESULT()
RETURN

'BSM% IS 1 IF THE ENTRY IS JUST WHAT THE PROJECT HOLDS: SAVING IT WOULD COST
'DIALOGS FOR NOTHING. LOADV ASKS NOTHING IN A PROGRAM. ANY DOUBT MEANS WRITE IT
@BSAME
BSM%=0
IF !HASFILE(BN$) THEN RETURN
FREEMEM OUT CM%,TM%
IF CM%<BSIZE%*2+1024 THEN RETURN
BOLD=LOADV(BN$)
IF RESULT()!=1 THEN BOLD=0:RETURN
CASE MID$(BN$,0,4)
WHEN "TXT:"
 IF TYPEOF(BOLD)==#T_STR THEN BSM%=(BOLD==FT$)
WHEN "DAT:"
 IF TYPEOF(BOLD)==#T_INTARRAY && DIM(BOLD)==1 && LEN(BOLD)==BW% THEN
  BI%=0
  WHILE BI%<BW% && BOLD[BI%]==FW%[BI%]:INC BI%:WEND
  BSM%=(BI%==BW%)
 ENDIF
WHEN "GRP:"
 IF TYPEOF(BOLD)==#T_INTARRAY && DIM(BOLD)==2 && DIM(BOLD,0)==GRPH% && DIM(BOLD,1)==GRPW% THEN
  BSM%=1
  BI%=1
  FOR Y%=0 TO GRPH%-1
   FOR X%=0 TO GRPW%-1
    IF BOLD[Y%,X%]!=FW%[BI%] THEN BSM%=0:BREAK
    INC BI%
   NEXT
   IF !BSM% THEN BREAK
  NEXT
 ENDIF
ENDCASE
BOLD=0
RETURN

'BCNT% WORDS OF THE IMAGE INTO FW% FROM BDST%. THE IMAGE COMES IN ORDER AND A
'MATCH MAY RUN ACROSS CALLS, SO ZL%, ZK% AND THE FLAGS LAST FROM ONE TO THE NEXT.
'BCNT% LEFT ABOVE 0 MEANS THE ARCHIVE RAN OUT
@BREAD
IF BCNT%>(BIMGN%-BIMG%) DIV 4 THEN RETURN
ZB%=BDST%
IF BMETH%==0 THEN
 WHILE BCNT%>0
  IF BPOS%>=LEN(BUF%) THEN
   GOSUB @BNEXT
   IF ZERR% THEN BREAK
   CONTINUE
  ENDIF
  BI%=MIN(BCNT%,LEN(BUF%)-BPOS%)
  COPY FW%,BDST%,BUF%,BPOS%,BI%
  INC BDST%,BI%:INC BPOS%,BI%:DEC BCNT%,BI%
  INC BIMG%,BI%*4
  ZB%=BDST%
 WEND
 RETURN
ENDIF
ZE%=BDST%+BCNT%:ZS%=0:RW%=0
WHILE BDST%<ZE%
 IF ZL%==0 THEN
  IF ZFN%==0 THEN
   IF ZP%>=ZN% THEN GOSUB @BNEXT
   ZF%=(BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255:INC ZP%:ZFN%=8
  ENDIF
  DEC ZFN%
  ZX%=ZF% AND 1:ZF%=ZF%>>1
  IF ZX%==0 THEN
   IF ZP%>=ZN% THEN GOSUB @BNEXT
   B%=(BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255:INC ZP%
   RG%[RI%]=B%:RI%=(RI%+1) AND 65535
   RW%=RW% OR (B%<<ZS%)
   IF ZS%==24 THEN FW%[BDST%]=RW%:INC BDST%:RW%=0:ZS%=0 ELSE INC ZS%,8
   CONTINUE
  ENDIF
  IF ZFN%==0 THEN
   IF ZP%>=ZN% THEN GOSUB @BNEXT
   ZF%=(BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255:INC ZP%:ZFN%=8
  ENDIF
  DEC ZFN%
  ZX%=ZF% AND 1:ZF%=ZF%>>1
  IF ZP%>=ZN% THEN GOSUB @BNEXT
  ZD%=(BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255:INC ZP%
  IF ZP%>=ZN% THEN GOSUB @BNEXT
  ZD%=ZD% OR (((BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255)<<8):INC ZP%
  IF ZX%==0 THEN
   ZL%=(ZD%>>10)+2
   ZK%=(RI%-(ZD% AND 1023)-1) AND 65535
  ELSE
   IF ZP%>=ZN% THEN GOSUB @BNEXT
   ZL%=((BUF%[ZP%>>2]>>((ZP% AND 3)*8)) AND 255)+3:INC ZP%
   ZK%=(RI%-ZD%-1) AND 65535
  ENDIF
 ENDIF
 WHILE ZL%>0 && BDST%<ZE%
  B%=RG%[ZK%]:ZK%=(ZK%+1) AND 65535
  RG%[RI%]=B%:RI%=(RI%+1) AND 65535
  RW%=RW% OR (B%<<ZS%)
  IF ZS%==24 THEN FW%[BDST%]=RW%:INC BDST%:RW%=0:ZS%=0 ELSE INC ZS%,8
  DEC ZL%
 WEND
WEND
INC BIMG%,BCNT%*4
BCNT%=0
IF ZERR% THEN BCNT%=1
RETURN

'THE NEXT PART. PAST THE LAST THERE ARE ZEROS TO READ AND ZERR% IS SET, SO THAT
'THE LOOP ABOVE ENDS BY ITSELF AND ITS CALLER REPORTS IT
@BNEXT
INC BP%
IF BP%<ARN% THEN
 GOSUB @BPART
 BPOS%=3:ZP%=12:ZN%=LEN(BUF%)*4
 UUNPACKED BIMG%+(BDST%-ZB%)*4
ELSE
 ZERR%=1
 BUF%=ARRAY%(4)
 BPOS%=4:ZP%=0:ZN%=16
ENDIF
RETURN

'BPW% WORDS UNPACKED AND NOT KEPT
@BPASS
FW%=ARRAY%(4096)
WHILE BPW%>0
 BCNT%=MIN(BPW%,4096):BDST%=0
 DEC BPW%,BCNT%
 GOSUB @BREAD
 IF BCNT%>0 THEN BREAK
WEND
FW%=ARRAY%(0)
RETURN

'B% IS THE PART'S NEXT BYTE
@BOUT
IF OP%>=FILELEN% THEN BAD%=1:RETURN
CRC%=CRCTBL%[(CRC% XOR B%) AND 255] XOR (CRC%>>8)
RW%=RW% OR (B%<<((OP% AND 3)*8))
IF (OP% AND 3)==3 THEN RB%[OP%>>2]=RW%:RW%=0
INC OP%
RETURN

'FW% AS A STRING. PUSH MOVES A STRING EVERY 64 CHARACTERS,
'SO THEY GO IN STAGES AND THE LONG ONE GROWS RARELY
@BTEXT
FT$=""
BN2$=""
BN1$=""
FOR BI%=0 TO (BSIZE%+1) DIV 2-1
 BC%=FW%[BI%>>1]
 IF BI% AND 1 THEN BC%=(BC%>>16) AND &HFFFF ELSE BC%=BC% AND &HFFFF
 PUSH BN1$,CHR$(BC%)
 IF LEN(BN1$)>=1024 THEN
  BN2$=BN2$+BN1$:BN1$=""
  IF LEN(BN2$)>=65536 THEN FT$=FT$+BN2$:BN2$=""
 ENDIF
NEXT
FT$=FT$+BN2$+BN1$
BN2$="":BN1$=""
RETURN

'////////////////////////////////////////////////
@SCREENSHOT
FL$=FILES()
UCLS
UHEAD "SCREENSHOT SEND"
UBIG 30,"SELECT FILE",UCW%
UT 12,52,NFILES$(LEN(FL$)),UCL%
UFOOT "[A] SELECT  [B] BACK",""
IF LEN(FL$)==0 THEN
 UT 12,76,"NO FILES IN THIS PROJECT",UCY%
 WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
 WHILE BUTTON(0,-1,0)==0:VSYNC:WEND
 GOTO @TITLE
ENDIF
RESIZE UR$,0:RESIZE UD$,0:RESIZE UI$,0
I%=USEL(FL$,UR$,UD$,UI$,76,16,188,0,0)
IF I%<0 THEN GOTO @TITLE
FILENAME$=FL$[I%]

UCLS
UHEAD "SCREENSHOT SEND"
UBIG 30,"LOADING",UCK%
UT 12,52,FILENAME$,UCW%

'LOAD
RFC%=ARRAY%(0)
CASE MID$(FILENAME$,0,4)
WHEN "TXT:"
 FT$=LOADV(FILENAME$)
 FOR I%=0 TO LEN(FT$)-1
  PUSH RFC%, ASC(FT$[I%]) AND &HFF
  PUSH RFC%, ASC(FT$[I%]) >> 8
 NEXT
WHEN "GRP:"
 'ON ITS OWN PAGE: THE SCREEN STAYS
 LOADG FILENAME$,1 OUT GRPW%,GRPH%
 FG%=ARRAY%(0):GSAVE 1,0,0,GRPW%,GRPH%,FG%
 PUSH RFC%,GRPW% AND &HFF
 PUSH RFC%,(GRPW%>>8) AND &HFF
 PUSH RFC%,GRPH% AND &HFF
 PUSH RFC%,(GRPH%>>8) AND &HFF
 FOR Y%=0 TO GRPH%-1
  FOR X%=0 TO GRPW%-1
   PUSH RFC%,  FG%[X%+Y%*GRPW%]      AND &HFF
   PUSH RFC%, (FG%[X%+Y%*GRPW%]>> 8) AND &HFF
   PUSH RFC%, (FG%[X%+Y%*GRPW%]>>16) AND &HFF
   PUSH RFC%, (FG%[X%+Y%*GRPW%]>>24) AND &HFF
  NEXT
 NEXT
 GTARGET 1:GCLS:GTARGET 0
WHEN "DAT:"
 FI%=LOADV(FILENAME$)
 FOR I%=0 TO LEN(FI%)-1
  PUSH RFC%,  FI%[I%] AND &HFF
  PUSH RFC%, (FI%[I%]>> 8) AND &HFF
  PUSH RFC%, (FI%[I%]>>16) AND &HFF
  PUSH RFC%, (FI%[I%]>>24) AND &HFF
 NEXT
ENDCASE

'CALC CRC
CRC%=&HFFFF
FOR I%=0 TO LEN(RFC%)-1
 CRC%=CALC_CRC(CRC%,CRCTBL%,RFC%[I%])
NEXT
CRC%=CRC% XOR &HFFFF

'LZ
UCLR 12,30,20,16
UBIG 30,"COMPRESSING",UCK%
UT 12,102,"FILE",UCL%:UTR 102,UN$(LEN(RFC%))+" B",UCW%
UBARNEW
RZC%=ARRAY%(0):COMP%=1
LZ RFC%,RZC%,10,5,3,8,1
CLS
IF LEN(RZC%)*4>LEN(RFC%) THEN
 RZC%=ARRAY%(0)
 'ZEROS FILL THE LAST INT, AND THE FILE'S LENGTH SAYS WHERE IT ENDS
 STLEN%=LEN(RFC%)
 WHILE LEN(RFC%)MOD 4!=0:PUSH RFC%,0:WEND
 FOR I%=0 TO LEN(RFC%)-1 STEP 4
  PUSH RZC%,RFC%[I%] OR (RFC%[I%+1]<<8) OR (RFC%[I%+2]<<16) OR (RFC%[I%+3]<<24)
 NEXT
 RESIZE RFC%,STLEN%
 COMP%=0
ENDIF

HDS%=15 '15*4=60 BYTES HEADER
SCS%=720*720*14/5/8 'BYTES PER SCREEN (194400
TIMG%=CEIL(LEN(RZC%)*4/(SCS%-HDS%*4)) ' TOTALIMAGES

UCLS
UHEAD "SCREENSHOT SEND"
UBIG 30,"READY",UCK%
UT 12,52,FILENAME$,UCW%
UT 12,70,"PAGES",UCL%:UTR 70,STR$(TIMG%),UCW%
UMINI 12,80,376,12,"N"*MIN(TIMG%,#U_CELLS)
USTAT 12,108,"FILE SIZE",UN$(LEN(RFC%))+" B",UCW%
USTAT 140,108,"COMPRESSED",UN$(LEN(RZC%)*4)+" B",UCW%
USTAT 268,108,"CRC",HEX$(CRC%,4),UCW%
UT 12,146,"TAKE SCREENSHOT OF EACH PAGE.",UCL%
UT 12,162,"PRESS ANY BUTTON FOR NEXT PAGE.",UCL%
UFOOT "[B] BACK","[A] START"
WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
LOOP
 VSYNC
 IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
 IF BUTTON(0,#B_RRIGHT,1) THEN BREAK
ENDLOOP

'MAKE HEADER
HD%=ARRAY%(HDS%)
HD%[0]=&H505A5332 'PZS2
HD%[1]=LEN(RFC%)  'FILE SIZE
HD%[2]=CRC%       'CRC
FOR I%=0 TO LEN(FILENAME$)-1
 INC HD%[(I% DIV 4)+3],ASC(FILENAME$[I%])<<((I% MOD 4)*8)
NEXT
'FLUCTUATE PATTERN
XOR8%=RND(&H100):XOR32%=XOR8% OR ((XOR8%*&H010101)<<8)
HD%[12]=TIMG% OR (IMG%<<8) OR (XOR8%<<16) OR (COMP%<<24)
HD%[13]=0
HD%[14]=(720 AND &HFFFF) OR ((720 AND &HFFFF)<<16)

'DRAW
J%=0:C%=0:IMG%=0
GOTO @DRAWFIRST

@DRAWPAGE
'WAIT KEY INPUT
WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
WHILE BUTTON(0,-1,0)==0:VSYNC:WEND

@DRAWFIRST
ACLS:XSCREEN 1280,720
SUBFIT 1280,720
X0%=0:Y0%=0
'UPDATE STREAM LENGTH AND IMG NUM
STLEN%=MIN(SCS%-HDS%*4,(LEN(RZC%)-J%)*4)
HD%[12]=TIMG% OR (IMG%<<8) OR (XOR8%<<16) OR (COMP%<<24)
HD%[13]=STLEN%

I%=0:B%=0
LOOP
 IF I%<HDS% THEN
  T%=HD%[I%]>>B%:INC B%,14
  IF B%>=32 THEN
   INC I%:DEC B%,32
   T%=T% AND ((1<<(14-B%))-1)
   IF I%<HDS% THEN
    T%=T% OR (HD%[I%]<<(14-B%))
   ELSE
    T%=T% OR (((RZC%[J%] XOR XOR32%)>>C%)<<(14-B%))
    C%=C%+B%
   ENDIF
  ENDIF
 ELSEIF J%<LEN(RZC%) THEN
  T%=(RZC%[J%] XOR XOR32%)>>C%:INC C%,14
  IF C%>=32 THEN
   INC J%:DEC C%,32
   T%=T% AND ((1<<(14-C%))-1)
   IF J%<LEN(RZC%) THEN
    T%=T% OR ((RZC%[J%] XOR XOR32%)<<(14-C%))
   ENDIF
  ENDIF
 ELSE
  BREAK
 ENDIF
 T%=T% AND &H3FFF '14BIT
 FOR K%=0 TO 4
  GPSET X0%,Y0%,COLTBL%[T% MOD 7]
  T%=T% DIV 7:INC Y0%
 NEXT
 IF J%>=LEN(RZC%) THEN BREAK
 IF Y0%>=720 THEN
  Y0%=0:INC X0%
  IF X0%>=720 THEN
   Y0%=0:INC IMG%
   'WAIT INPUT
   GOTO @DRAWPAGE
  ENDIF
 ENDIF
ENDLOOP

WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
WHILE BUTTON(0,-1,0)==0:VSYNC:WEND
ACLS
SUBFIT 400,240
UCLS
UHEAD "SCREENSHOT SEND"
UBIG 30,"ALL PAGES SHOWN",UCK%
UT 12,52,FILENAME$,UCW%
UT 12,70,"PAGES",UCL%:UTR 70,STR$(TIMG%)+" OF "+STR$(TIMG%),UCW%
UMINI 12,80,376,12,"D"*MIN(TIMG%,#U_CELLS)
UT 12,108,"ON PC:",UCW%
UT 28,124,"p4recv.py -o OUT_DIR PICTURES",UCK%
UFOOT "[B] MENU","[A] SELECT ANOTHER FILE"
WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
LOOP
 VSYNC
 IF BUTTON(0,#B_RDOWN,1) THEN GOTO @TITLE
 IF BUTTON(0,#B_RRIGHT,1) THEN GOTO @SCREENSHOT
ENDLOOP

'////////////////////////////////////////////////
'SHOWS A SUBPROGRAM'S SCREEN, WHICH NOTHING SHOWS UNTIL XSUBSCREEN, OVER ALL OF
'THE MAIN ONE. A SUB SCREEN IS STRETCHED SMOOTHLY: THE CONSOLE IS DRAWN AT A WHOLE
'3 TIMES, 1200X720, WHICH FITS ONE TO ONE, AND BACKCOLOR FILLS THE SIDES. A SCREENSHOT
'PAGE IS ONE TO ONE AS IT IS. A CLEAR BACKCOLOR WOULD LET THE MAIN ONE THROUGH.
'ACLS UNDOES IT
DEF SUBFIT W%,H%
 IF ISSUB% THEN
  XSUBSCREEN 0,0,1280,720
  IF W%==400 THEN XSCREEN 400,240,3,1 ELSE XSCREEN W%,H%
  BACKCOLOR RGB(0,0,0)
 ENDIF
END

'A LIST TO CHOOSE FROM. R$ IS WHAT STANDS ON THE RIGHT OF A ROW, D$ A SMALL BAR UNDER IT,
'I$ A LINE ABOUT THE CHOSEN ROW AT Y YD%. RETURNS THE CHOICE, OR -1 FOR B OR ESC
DEF USEL(L$[],R$[],D$[],I$[],Y0%,DY%,YM%,YD%,INI%)
 VAR CUR%=INI%,FST%,I%,Y%,B%,IN$,SCNT%=-1,X#,S#,N%=LEN(L$),LASTV%,CH%,B0%,PB%=-1,E%
 WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
 WHILE INKEY$()!="" WEND
 IF CUR%<0 || CUR%>=N% THEN CUR%=0
 LOOP
  'THE WINDOW HOLDS THE CHOSEN ROW
  IF CUR%<FST% THEN FST%=CUR%
  LOOP
   Y%=Y0%:LASTV%=FST%-1
   FOR I%=FST% TO N%-1
    IF Y%>YM% THEN BREAK
    LASTV%=I%
    INC Y%,DY%
    IF LEN(D$)>I% && D$[I%]!="" THEN INC Y%,4
   NEXT
   IF LASTV%>=CUR% THEN BREAK
   INC FST%
  ENDLOOP
  UCLR 12,Y0%-14,47,YM%-Y0%+28
  IF FST%>0 THEN UTR Y0%-14,"MORE ^",UCL%
  Y%=Y0%
  FOR I%=FST% TO LASTV%
   CH%=(I%==CUR%)
   IF CH% THEN
    GBOX 12,Y%-4,387,Y%+11,UCK%
    GFILL 12,Y%-4,15,Y%+11,UCK%
    UT 24,Y%,L$[I%],UCK%
   ELSE
    UT 24,Y%,L$[I%],UCW%
   ENDIF
   IF LEN(R$)>I% && R$[I%]!="" THEN UT 380-LEN(R$[I%])*8,Y%,R$[I%],UCL%
   IF LEN(D$)>I% && D$[I%]!="" THEN UMINI 24,Y%+14,352,6,D$[I%]
   INC Y%,DY%
   IF LEN(D$)>I% && D$[I%]!="" THEN INC Y%,4
  NEXT
  IF LASTV%<N%-1 THEN UTR YM%+6,"MORE V",UCL%
  IF LEN(I$)>CUR% THEN
   UCLR 12,YD%,47,8
   UT 12,YD%,I$[CUR%],UCL%
  ENDIF
  LOOP
   'A AND B COUNT ONLY WHEN SEEN GOING DOWN HERE: THE PRESS THAT OPENED THIS LIST DOES NOT
   VSYNC 1:B%=BUTTON(0,-1,1):B0%=BUTTON(0,-1,0):E%=B0% AND (PB% XOR -1):PB%=B0%:IN$=INKEY$()
   IF IN$==CHR$(27) || E% AND (1<<#B_RDOWN) THEN RETURN -1
   IF IN$==CHR$(13) || E% AND (1<<#B_RRIGHT) THEN RETURN CUR%
   IF (IN$==CHR$(30) || B% AND (1<<#B_LUP)) && CUR%>0 THEN DEC CUR%:BREAK
   IF (IN$==CHR$(31) || B% AND (1<<#B_LDOWN)) && CUR%+1<N% THEN INC CUR%:BREAK
   STICK 0 OUT X#,S#
   IF ABS(S#)>0.5 THEN
    IF MAINCNT()>SCNT% THEN
     IF SCNT%<0 THEN SCNT%=MAINCNT()+30 ELSE SCNT%=MAINCNT()+3
     IF S#>0.5 THEN CUR%=MIN(CUR%+5,N%-1) ELSE CUR%=MAX(CUR%-5,0)
     BREAK
    ENDIF
   ELSE
    SCNT%=-1
   ENDIF
  ENDLOOP
 ENDLOOP
END

'A COLUMN OF THE SYNC KEY'S COUNTS
DEF UHIST K%
 VAR X%=12+K%*15,H%=MIN(MAX(SKT%[K%]*3/2,1),44),C%=UCG%
 IF K%==SK% THEN C%=UCK%
 GFILL X%,82,X%+12,126,UCB%
 GFILL X%,126-H%,X%+12,126,C%
END


DEF LZ IN%[],OUT%[],WLB%,MLB%,MM%,BIT%,PROG%
 WLB%=MIN(MAX(WLB%,7),16)
 MLB%=MIN(MAX(MLB%,3),8)
 MM%=MIN(MAX(MM%,3),10)
 
 VAR WL%=(1<<WLB%)
 VAR WLM%=WL%-1
 VAR ML%=(1<<MLB%)-1
 VAR PH%,PL%,Q%,P%,P2%,OL%,O%
 VAR MD%,MP%,MLL%,D%,L%,B%,I%,DD%
 VAR LEN_IN% =LEN(IN%)
 VAR LEN_OUT%=LEN(IN%)*BIT%/8+ML%
 DIM BB%[WL%+ML%+1]
 DIM HS%[256],HL%[WL%]
 VAR H1%,H2%,HLI%=0
 VAR HS1%,HS2%,HS3%
 VAR CNT%=0
 
 FOR I%=0 TO 255:HS%[I%]=-1:NEXT
 PH%=0:PL%=0
 IF PH%<LEN_IN% THEN Q%=IN%[PH%] ELSE Q%=0
 P%=ML%
 FOR I%=0 TO ML%
  BB%[WL%+I%]=(Q%>>PL%) AND 255
  INC PL%,8:IF PL%>=BIT% THEN
   INC PH%:PL%=0
   IF PH%<LEN_IN% THEN Q%=IN%[PH%] ELSE Q%=0
  ENDIF
 NEXT
 HS1%=BB%[WL%]
 HS2%=BB%[WL%+1]
 HS3%=BB%[WL%+2]
 H1%=HS1% XOR HS2% XOR HS3%
 
 
 WHILE P%<LEN_OUT%
  IF PROG% THEN
   INC CNT%
   IF CNT%>16 THEN
    CNT%=0
    UBARTO P%/LEN_OUT%
   ENDIF
  ENDIF
  
  MLL%=-1
  H2%=HS%[H1%]
  WHILE H2%>=0
   D%=(P%-ML%)-H2%
   IF D%>WL% THEN BREAK
   L%=1:P2%=WL%-D%
   WHILE P%+L%<LEN_OUT%
    IF BB%[P2%+L%]!=BB%[WL%+L%] THEN BREAK
    INC L%
    IF L%>ML% THEN MD%=D%:MLL%=L%:GOTO @LZ1
   WEND
   IF L%>MLL% THEN MD%=D%:MLL%=L%
   DEC H2%,HL%[H2% AND WLM%]
  WEND
  
  @LZ1
  IF MLL%<MM% THEN
   MLL%=1
   INC OL%
   IF OL%>=32 THEN
    PUSH OUT%,O%:O%=0:OL%=0
   ENDIF
   B%=HS1%'BB%[WL%]
   O%=O% OR (B%<<OL%)
   INC OL%,8
   IF OL%>=32 THEN
    PUSH OUT%,O%:DEC OL%,32
    O%=B%>>(8-OL%)
   ENDIF
  ELSE
   O%=O% OR (1<<OL%)
   INC OL%
   IF OL%>=32 THEN
    PUSH OUT%,O%:O%=0:OL%=0
   ENDIF
   B%=MD%-1
   O%=O% OR (B%<<OL%)
   INC OL%,WLB%
   IF OL%>=32 THEN
    PUSH OUT%,O%:DEC OL%,32
    O%=B%>>(WLB%-OL%)
   ENDIF
   B%=MLL%-1
   O%=O% OR (B%<<OL%)
   INC OL%,MLB%
   IF OL%>=32 THEN
    PUSH OUT%,O%:DEC OL%,32
    O%=B%>>(MLB%-OL%)
   ENDIF
  ENDIF
  I%=0
  REPEAT
   H2%=HS%[H1%]
   HS%[H1%]=P%-ML%
   HL%[HLI% AND WLM%]=HLI%-H2%
   INC HLI%
   B%=(Q%>>PL%) AND 255
   PUSH BB%,B%:B%=SHIFT(BB%)
   HS1%=HS2%:HS2%=HS3%
   HS3%=BB%[WL%+2]
   H1%=HS1% XOR HS2% XOR HS3%
   INC P%
   INC PL%,8:IF PL%>=BIT% THEN
    INC PH%:PL%=0
    IF PH%<LEN_IN% THEN Q%=IN%[PH%] ELSE Q%=0
   ENDIF
   INC I%
  UNTIL I%>=MLL%
 WEND
 IF OL%>0 THEN PUSH OUT%,O%
 IF PROG% THEN UBARTO 1
END

DEF UNLZ IN%[],INOFS%,OUT%[],WLB%,MLB%,BIT%,PROG%
 VAR J%=0,C%,L%,D%,B%,P%
 VAR OL%=0,O%=0,K%,I%
 VAR WL%=(1<<WLB%)-1
 VAR ML%=(1<<MLB%)-1
 VAR LEN_IN%=LEN(IN%)
 VAR CNT%=0
 DIM BB%[WL%+1]
 VAR BBI%=0
 
 P%=IN%[INOFS%]
 WHILE INOFS%<LEN_IN%
  IF PROG% THEN
   INC CNT%
   IF CNT%>16 THEN
    CNT%=0
    UBARTO INOFS%/LEN_IN%
   ENDIF
  ENDIF
  C%=(P%>>J%) AND 1
  INC J%
  IF J%>=32 THEN
   INC INOFS%:DEC J%,32
   IF INOFS%>=LEN_IN% THEN BREAK
   P%=IN%[INOFS%]
  ENDIF
  
  IF C%==0 THEN
   B%=(P%>>J%) AND 255
   INC J%,8
   IF J%>=32 THEN
    INC INOFS%:DEC J%,32
    B%= B% AND ((1<<(8-J%))-1)
    IF INOFS%<LEN_IN% THEN
     P%=IN%[INOFS%]
     B%=(B% OR (P%<<(8-J%))) AND 255
    ENDIF
   ENDIF
   O%=O% OR (B%<<OL%)
   BB%[BBI%]=B%
   INC BBI%:IF BBI%>WL% THEN BBI%=0
   INC OL%,8
   IF OL%>=BIT% THEN PUSH OUT%,O%:OL%=0:O%=0
  ELSE
   D%=((P%>>J%) AND WL%)
   INC J%,WLB%
   IF J%>=32 THEN
    INC INOFS%:DEC J%,32:P%=IN%[INOFS%]
    D%= D% AND ((1<<(WLB%-J%))-1)
    D%=(D% OR (P%<<(WLB%-J%))) AND WL%
   ENDIF
   L%=((P%>>J%) AND ML%)
   INC J%,MLB%
   IF J%>=32 THEN
    INC INOFS%:DEC J%,32
    L%= L% AND ((1<<(MLB%-J%))-1)
    IF INOFS%<LEN_IN% THEN
     P%=IN%[INOFS%]
     L%=(L% OR (P%<<(MLB%-J%))) AND ML%
    ENDIF
   ENDIF
   L%=L%+1
   K%=WL%-D%+BBI%
   IF K%>WL% THEN DEC K%,WL%+1
   FOR I%=1 TO L%
    B%=BB%[K%]
    O%=O% OR (B%<<OL%)
    BB%[BBI%]=B%
    INC BBI%:IF BBI%>WL% THEN BBI%=0
    INC K%:IF K%>WL% THEN K%=0
    INC OL%,8
    IF OL%>=BIT% THEN PUSH OUT%,O%:OL%=0:O%=0
   NEXT
  ENDIF
 WEND
 IF PROG% THEN UBARTO 1
END

DEF CALC_CRCTBL()
 DIM T%[256]
 VAR I%,J%,K%
 FOR I%=0 TO 255
  K%=I%
  FOR J%=0 TO 7
   IF (K%AND 1)==1 THEN
    K%=(&HC7ED XOR (K%>>1))
   ELSE
    K%=K%>>1
   ENDIF
  NEXT
  T%[I%]=K%
 NEXT
 RETURN T%
END

DEF CALC_CRC(C%,TBL%[],B%)
 RETURN(TBL%[(C% XOR B%)AND&HFF]XOR(C%>>8))
END

'////////////////////////////////////////////////
'ARCHIVE FUNCTIONS (NOT IN PETIT4SEND 1.2.2)
DEF WARNSLEEP
 UCLS
 UHEAD "USB RECEIVE"
 UBIG 30,"TURN OFF AUTO-SLEEP",UCY%
 UT 12,62,"AUTO-SLEEP MAY INTERRUPT FILE TRANSFER,",UCW%
 UT 12,74,"ESPECIALLY WITH LARGE FILES.",UCW%
 UT 12,98,"SYSTEM SETTINGS > SLEEP MODE",UCK%
 UT 12,122,"DO NOT USE MOUSE OR CONTROLLER DURING TRANSFER",UCL%
 UFOOT "[A]/[ENTER] CONTINUE",""
 BGMPLAY 129
 WHILE BUTTON(0,-1,0)!=0:VSYNC:WEND
 WHILE INKEY$()!="" WEND
 LOOP
  VSYNC
  IF BUTTON(0,#B_RRIGHT,1) || INKEY$()==CHR$(13) THEN BREAK
 ENDLOOP
END

'THE PARTS IN THIS PROJECT, GROUPED BY THEIR ARCHIVE ID
DEF BSCAN
 DIM L$[],A%[]
 VAR I%,N%,K%,G%,J%
 L$=FILES()
 FOR I%=0 TO LEN(L$)-1
  IF PARTNO(L$[I%])>=0 THEN INC N%
 NEXT
 IF N%>0 THEN UT 12,52,"READING UNFINISHED TRANSFERS...",UCL%
 BPF$=ARRAY$(MAX(N%,1))
 BPG%=ARRAY%(MAX(N%,1))
 BGID%=ARRAY%(8):BGN%=ARRAY%(8):BGC%=ARRAY%(8)
 BNG%=0:BNB%=0
 N%=0
 FOR I%=0 TO LEN(L$)-1
  K%=PARTNO(L$[I%])
  IF K%<0 THEN CONTINUE
  BPF$[N%]=L$[I%]
  A%=LOADV(L$[I%])
  G%=-1
  IF RESULT()==1 && LEN(A%)>=3 THEN
   IF A%[1]==K% && A%[2]>K% THEN
    'A PART BEFORE THE LAST HAS THE FULL SIZE
    IF K%<A%[2]-1 && LEN(A%)*4>UFULL% THEN UFULL%=LEN(A%)*4
    FOR J%=0 TO BNG%-1
     IF BGID%[J%]==A%[0] && BGC%[J%]==A%[2] THEN G%=J%:BREAK
    NEXT
    IF G%<0 && BNG%<8 THEN
     G%=BNG%:INC BNG%
     BGID%[G%]=A%[0]:BGC%[G%]=A%[2]
    ENDIF
   ENDIF
  ENDIF
  BPG%[N%]=G%
  IF G%<0 THEN INC BNB% ELSE INC BGN%[G%]
  INC N%
 NEXT
END

'THE INDEX IN A PART'S NAME, OR -1
DEF PARTNO(N$)
 VAR I%,C%,R%
 IF LEN(N$)!=12 || MID$(N$,0,7)!="DAT:P4A" THEN RETURN -1
 FOR I%=7 TO 11
  C%=ASC(N$[I%])
  IF C%<48 || C%>57 THEN RETURN -1
  R%=R%*10+C%-48
 NEXT
 RETURN R%
END

DEF PARTNAME$(K%)
 RETURN "DAT:P4A"+FORMAT$("%05D",K%)
END

DEF HEXID$(V%)
 RETURN HEX$((V%>>16) AND &HFFFF,4)+HEX$(V% AND &HFFFF,4)
END

'THE SCREEN. EVERY ERASE GOES THROUGH UCLR, EVERY TEXT THROUGH UT, UTR OR UBIG
DEF UCLS
 VAR I%
 GCLS UCB%
 CLS
 FOR I%=0 TO LEN(UCV$)-1:UCV$[I%]="":NEXT
END

DEF UCLR X%,Y%,W%,H%
 GFILL X%,Y%,X%+W%*8-1,Y%+H%-1,UCB%
END

DEF UT X%,Y%,S$,C%
 GPUTCHR X%,Y%,S$,8,1,1,C%
END

DEF UTR Y%,S$,C%
 UT 388-LEN(S$)*8,Y%,S$,C%
END

DEF UBIG Y%,S$,C%
 GPUTCHR 12,Y%,S$,8,2,2,C%
END

'TEXT THAT CHANGES: DRAWN ONLY WHEN IT DOES. I% IS ITS PLACE IN THE CACHE
DEF UV I%,X%,Y%,W%,S$,C%
 IF UCV$[I%]==S$ THEN RETURN
 UCV$[I%]=S$
 UCLR X%,Y%,W%,8
 UT X%,Y%,S$,C%
END

DEF UVR I%,Y%,W%,S$,C%
 IF UCV$[I%]==S$ THEN RETURN
 UCV$[I%]=S$
 UCLR 388-W%*8,Y%,W%,8
 UTR Y%,S$,C%
END

DEF UHEAD M$
 UT 12,8,"P4SENDX",UCT%
 UVR 0,8,30,M$,UCL%
 GFILL 12,20,387,20,UCG%
END

DEF UFOOT A$,B$
 GFILL 12,214,387,214,UCG%
 UT 12,222,A$,UCL%
 IF B$!="" THEN UTR 222,B$,UCL%
END

DEF USTAT X%,Y%,L$,V$,C%
 UT X%,Y%,L$,UCL%
 UT X%,Y%+10,V$,C%
END

'1,234,567
DEF UN$(N%)
 VAR S$=STR$(INT(N%)),R$=""
 WHILE LEN(S$)>3
  R$=","+MID$(S$,LEN(S$)-3,3)+R$
  S$=MID$(S$,0,LEN(S$)-3)
 WEND
 RETURN S$+R$
END

'M:SS OR H:MM:SS
DEF UTIME$(T%)
 VAR H%=INT(T%) DIV 3600,M%=(T% DIV 60) MOD 60,S%=T% MOD 60
 IF H%>0 THEN RETURN STR$(H%)+":"+FORMAT$("%02D",M%)+":"+FORMAT$("%02D",S%)
 RETURN STR$(M%)+":"+FORMAT$("%02D",S%)
END

DEF NFILES$(N%)
 IF N%==1 THEN RETURN "1 FILE"
 RETURN STR$(N%)+" FILES"
END

DEF NARCH$(N%)
 IF N%==1 THEN RETURN "1 ARCHIVE"
 RETURN STR$(N%)+" ARCHIVES"
END

DEF NPACK$(N%)
 IF N%==1 THEN RETURN "1 PACKET"
 RETURN STR$(N%)+" PACKETS"
END

DEF UMISS$(N%)
 IF N%==1 THEN RETURN "1 PACKET MISSING"
 RETURN STR$(N%)+" PACKETS MISSING"
END

'A BAR OF CELLS FROM A STRING: D DONE, F FAILED, ANYTHING ELSE NOT YET
DEF UMINI X%,Y%,W%,H%,D$
 VAR N%=LEN(D$),I%,X0%,X1%,C%,G%=2
 IF N%>60 || W%<376 THEN G%=1
 FOR I%=0 TO N%-1
  X0%=X%+I%*(W%+G%) DIV N%
  X1%=X%+(I%+1)*(W%+G%) DIV N%-G%-1
  C%=UCG%
  IF D$[I%]=="D" THEN C%=UCK%
  IF D$[I%]=="F" THEN C%=UCO%
  GFILL X0%,Y%,X1%,Y%+H%-1,C%
 NEXT
END

'CELLS OF ONE SAVED ARCHIVE, FOR THE LIST. MANY PARTS SHARE A CELL
DEF UCELLS$(G%)
 VAR N%=BGC%[G%],C%=MIN(N%,176),I%,K%,R$=""
 DIM H%[N%],T%[C%],D%[C%]
 FOR I%=0 TO LEN(BPF$)-1
  IF BPF$[I%]!="" && BPG%[I%]==G% THEN H%[VAL(MID$(BPF$[I%],7,5))]=1
 NEXT
 FOR I%=0 TO N%-1
  K%=I%*C% DIV N%
  INC T%[K%]:INC D%[K%],H%[I%]
 NEXT
 FOR I%=0 TO C%-1
  IF T%[I%]==D%[I%] THEN R$=R$+"D" ELSE R$=R$+"N"
 NEXT
 RETURN R$
END

'THE PARTS BAR. A CELL IS ORANGE IF ANY OF ITS PARTS FAILED, GREEN IF ALL ARE DONE
DEF UPARTS
 IF URN%<=0 THEN
  GFILL 12,80,387,91,UCG%
  RETURN
 ENDIF
 VAR C%=MIN(URN%,#U_CELLS),I%,K%,R$=""
 DIM T%[C%],D%[C%],F%[C%]
 FOR I%=0 TO URN%-1
  K%=I%*C% DIV URN%
  INC T%[K%]
  IF ARSET% THEN INC D%[K%],BHAVE%[I%]
  INC F%[K%],UFP%[I%]
 NEXT
 FOR I%=0 TO C%-1
  IF F%[I%]>0 THEN
   R$=R$+"F"
  ELSEIF T%[I%]==D%[I%] THEN
   R$=R$+"D"
  ELSE
   R$=R$+"N"
  ENDIF
 NEXT
 UMINI 12,80,376,12,R$
END

'THE GREEN GROWING IN THE CELL OF PART BK%. F# OF THE PART IS HERE
DEF UPARTFILL F#
 IF URN%<=0 || BK%>=URN% THEN RETURN
 VAR C%=MIN(URN%,#U_CELLS),G%=2,K%=BK%*C% DIV URN%,A%,B%,X%,N%
 IF C%>60 THEN G%=1
 A%=K%*URN% DIV C%
 IF (K%*URN%) MOD C%>0 THEN INC A%
 B%=((K%+1)*URN%-1) DIV C%
 N%=B%-A%+1
 VAR X0%=12+K%*(376+G%) DIV C%,X1%=12+(K%+1)*(376+G%) DIV C%-G%-1
 X%=X0%+(X1%-X0%)*(BK%-A%+F#)/N%
 IF X%>UPX% THEN
  GFILL MAX(UPX%+1,X0%),80,X%,91,UCK%
  UPX%=X%
 ENDIF
END

'THE LOWER BAR: FILLED FROM WHERE IT WAS
DEF UBARTO P#
 VAR X%=12+375*P#
 IF P#<=0 THEN RETURN
 IF X%>UBAR% THEN
  GFILL UBAR%+1,112,X%,127,UCK%
  UBAR%=X%
 ENDIF
END

DEF UBARNEW
 GFILL 12,112,387,127,UCG%
 UBAR%=11
END

'S: HOW LIKELY THE NEXT PART IS TO ARRIVE, FROM E PACKETS EXPECTED AND M MISSING
'IN GR GROUPS OF G, GF OF THEM NOT REPAIRED, AND B BYTES IN A STREAM
DEF USIGS(E#,M#,GR#,GF#,G%,B#)
 IF E#<=0 THEN RETURN 1
 VAR P#=M#/E#,F#
 IF G%==0 THEN RETURN POW(1-P#,B#*16/79)
 IF GR#>0 THEN F#=GF#/GR#
 F#=MIN(MAX(G%*(G%-1)/2*P#*P#,F#),1)
 IF XM% THEN RETURN POW(1-F#,CEIL(B#*8/((G%-1)*XB%*18)))
 RETURN POW(1-F#,CEIL(B#*8/(G%/2*79-42)))
END

DEF USIGN(S#)
 IF S#>=#U_S4 THEN RETURN 4
 IF S#>=#U_S3 THEN RETURN 3
 IF S#>=#U_S2 THEN RETURN 2
 IF S#>=#U_S1 THEN RETURN 1
 RETURN 0
END

'THE ICON: N% OF 4 BARS. BELOW 0 MEANS STILL COLLECTING
DEF USIGNAL N%
 VAR I%,C%,X%,H%
 FOR I%=0 TO 3
  X%=350+I%*10
  H%=5+I%*4
  C%=UCG%
  IF N%>I% THEN
   C%=UCK%
   IF N%==2 THEN C%=UCY%
   IF N%<=1 THEN C%=UCO%
  ENDIF
  GFILL X%,46-H%,X%+7,46,C%
 NEXT
END

'A SECOND OF ACTIVE RECEPTION HAS PASSED: THE WINDOW, THEN THE ICON
DEF USIGTICK
 INC UACT%,60
 INC UALLP%,UCP%
 INC USE%,UCP%:INC USM%,UCM%:INC USG%,UCGR%:INC USF%,UCGF%
 INC UBP%[USI%],UCP%:INC UBM%[USI%],UCM%:INC UBG%[USI%],UCGR%:INC UBF%[USI%],UCGF%
 UCP%=0:UCM%=0:UCGR%=0:UCGF%=0
 IF UACT% MOD #U_BUCKET_F==0 THEN
  USI%=(USI%+1) MOD #U_BUCKETS
  DEC USE%,UBP%[USI%]:DEC USM%,UBM%[USI%]:DEC USG%,UBG%[USI%]:DEC USF%,UBF%[USI%]
  UBP%[USI%]=0:UBM%[USI%]=0:UBG%[USI%]=0:UBF%[USI%]=0
 ENDIF
 IF UACT%<#U_GREY_F THEN RETURN
 VAR N%=USIGN(USIGS(USE%,USM%,USG%,USF%,PG%,UPG#))
 IF N%<USIG% || USIG%<0 THEN
  USIG%=N%:USUP%=0
  USIGNAL USIG%
 ELSEIF N%>USIG% THEN
  INC USUP%,60
  IF USUP%>=#U_RISE_F THEN
   USIG%=N%:USUP%=0
   USIGNAL USIG%
  ENDIF
 ELSE
  USUP%=0
 ENDIF
END

'WHAT THE HEADER SAYS OF THE LINK: MEASURED, AND A SYNC KEY ONLY IF ONE WAS FOUND
DEF UHEADLINK F%,P%
 IF F%<=0 || P%<=0 THEN RETURN
 VAR S%=P%*60/F%,H$
 IF XM% THEN
  UVR 0,8,30,"NS"+STR$(XB%-5)+" / "+STR$(1000*F%/60 DIV P%)+" MS",UCL%
  RETURN
 ENDIF
 IF S%>=50 THEN
  H$="FAST"
  IF USK%>=0 THEN H$=H$+" / SYNC KEY "+STR$(USK%) ELSE H$=H$+" / "+STR$(1000*F%/60 DIV P%)+" MS"
 ELSE
  H$="SLOW / "+STR$(1000*F%/60 DIV P%)+" MS"
 ENDIF
 UVR 0,8,30,H$,UCL%
END

DEF UWAIT
 VAR I%
 UMODE%=0
 UCLS
 IF USK%>=0 THEN UHEAD "SYNC KEY "+STR$(USK%) ELSE UHEAD "USB RECEIVE"
 UBIG 30,"WAITING FOR FILE",UCW%
 IF USIG%>=0 THEN USIGNAL USIG%
 IF ARSET% THEN
  UT 12,52,"ARCHIVE "+HEXID$(ARID%),UCL%
  UT 12,70,"PARTS",UCL%:UTR 70,STR$(BNEED%)+" OF "+STR$(ARN%),UCW%
  UPARTS
  UBIG 116,"NEXT PART: "+STR$(BNEED%),UCK%
  IF BSEEN% THEN
   UT 12,138,"WAITING FOR PART "+STR$(BNEED%),UCL%
  ELSE
   UT 12,138,"SET START PART "+STR$(BNEED%)+" ON FLIPPER, THEN RUN.",UCL%
  ENDIF
  UFOOT "[B] BACK","[X] UNFINISHED TRANSFERS"
 ELSE
  UFOOT "[B] BACK",""
 ENDIF
END

'A PART IS COMING IN. ITS FIRST WORDS TELL HOW MANY PARTS THERE ARE
DEF URECV
 VAR T%=(BK%==UTRYK%)
 UMODE%=1
 IF T% && BK%<URN% THEN UFP%[BK%]=0
 UCLS
 UHEAD "USB RECEIVE"
 IF T% THEN UBIG 30,"RETRYING",UCK% ELSE UBIG 30,"RECEIVING",UCK%
 USIGNAL USIG%
 IF ARSET% THEN UT 12,52,"ARCHIVE "+HEXID$(ARID%),UCL%
 UT 12,70,"PARTS",UCL%
 UPARTS
 UPX%=-1
 IF T% THEN
  UT 12,102,"PART "+STR$(BK%)+", TRY "+STR$(UTRYN%+1),UCL%
 ELSE
  UT 12,102,"PART "+STR$(BK%),UCL%
 ENDIF
 UBARNEW
 UT 12,142,"SPEED",UCL%
 UT 140,142,"THIS PART",UCL%
 UT 268,142,"ALL PARTS",UCL%
 UT 12,172,"RECEIVED",UCL%
 UFOOT "[B] BACK","[X] UNFINISHED TRANSFERS"
END

'ONE FILE IS COMING IN
DEF UONEFILE
 VAR S$
 UMODE%=2
 UCLS
 UHEAD "USB RECEIVE"
 UBIG 30,"RECEIVING",UCK%
 USIGNAL USIG%
 UT 12,52,FILENAME$,UCW%
 IF PG%>0 THEN S$="PARITY 1/"+STR$(PG%) ELSE S$="NO PARITY"
 IF COMP%==1 THEN S$=S$+", LZSS"
 IF MID$(FILENAME$,0,4)=="GRP:" THEN S$=S$+", "+STR$(GRPW%)+"X"+STR$(GRPH%)
 UT 12,70,S$,UCL%
 UT 12,102,"SINGLE FILE",UCL%
 UBARNEW
 UT 12,142,"SPEED",UCL%
 UT 140,142,"THIS FILE",UCL%
 USTAT 12,172,"FILE SIZE",UN$(FILELEN%)+" B",UCW%
 UFOOT "[B] BACK",""
END

'WHILE ONE FILE, ALL HERE, IS WORKED ON
DEF USTAGE S$
 UCLR 12,30,20,16
 UBIG 30,S$,UCK%
END

'ONE FILE'S SIZE OR CRC DOES NOT MATCH
DEF UBADFILE S$
 UCLS
 UHEAD "USB RECEIVE"
 UBIG 30,S$,UCY%
 IF LEN(FILENAME$)>29 THEN UT 12,52,FILENAME$,UCW% ELSE UT 12,52,FILENAME$+" MAY BE CORRUPTED",UCW%
 IF LOSTP%>0 THEN UT 12,70,UMISS$(LOSTP%),UCY%
 UT 12,102,"SINGLE FILE",UCL%:UTR 102,UN$(LEN(RZC%))+" OF "+UN$(RTLEN%)+" B  100%",UCW%
 GFILL 12,112,387,127,UCO%
 UT 12,146,"PLEASE TRY AGAIN.",UCW%
 UT 12,162,"LOWER TRANSFER SPEED FOR STABILITY.",UCL%
 UFOOT "[B] BACK","[A] SAVE ANYWAY"
END

'NOW AND THEN WHILE A STREAM COMES. BELOW A FRAME'S WORTH IN ITS WORST CASE. THE
'RECEIVE LOOP HAS HAD THIS FRAME FIRST, AND A FRAME THAT ENDED A GROUP DRAWS NOTHING
@UTICK
IF UG% THEN UG%=0:UNX%=MAINCNT()+1:RETURN
UNX%=MAINCNT()+#U_TICK
IF STATE%>=2 THEN
 INC UAF%,MAINCNT()-ULAST%
 IF UAF%>=60 THEN DEC UAF%,60:USIGTICK
ENDIF
ULAST%=MAINCNT()
IF UMODE%==0 THEN RETURN
IF UMODE%==1 THEN UTICKPART ELSE UTICKFILE
RETURN

'THE LAST SECONDS' RATE. THE BYTES OF A PARITY GROUP COME TOGETHER, SO IT IS SMOOTHED
DEF USPEED(B%)
 VAR K%,F%,R%,N%=MAINCNT()
 UPK%=UALLP%+UCP%
 IF N%-UFR0%>=60 THEN
  USPB%[USPN% MOD 5]=B%:USPF%[USPN% MOD 5]=N%:USPP%[USPN% MOD 5]=UPK%
  INC USPN%
  UFR0%=N%
 ENDIF
 IF USPN%<2 THEN RETURN -1
 K%=MAX(USPN%-5,0) MOD 5
 F%=N%-USPF%[K%]
 IF F%<=0 THEN RETURN -1
 UHEADLINK F%,UPK%-USPP%[K%]
 RETURN INT((B%-USPB%[K%])*60/F%)
END

DEF UTICKPART
 VAR P#,B%=RP%,S%,L%,T%,F%,A%
 IF URN%==0 && OP%>=12 THEN
  'THE PREFIX HAS COME
  IF RB%[2]>=1 && RB%[2]<=100000 THEN
   URN%=RB%[2]
   UFP%=ARRAY%(URN%)
   UPARTS
   UPX%=-1
  ENDIF
 ENDIF
 P#=B%/MAX(RTLEN%,1)
 UVR 1,102,28,UN$(B%)+" OF "+UN$(RTLEN%)+" B   "+STR$(INT(P#*100))+"%",UCW%
 UBARTO P#
 UPARTFILL P#
 IF URN%>0 THEN UVR 2,70,12,STR$(BNEED%)+" OF "+STR$(URN%),UCW%
 S%=USPEED(B%)
 IF S%>0 THEN
  UV 3,12,152,14,UN$(S%)+" B/S",UCW%
  L%=INT((RTLEN%-B%)/S%)
  UV 4,140,152,15,UTIME$(L%)+" LEFT",UCW%
  IF URN%>0 THEN
   T%=INT(L%+(URN%-BK%-1)*(MAX(UFULL%,RTLEN%)/S%+UGAP%))
   UV 5,268,152,15,UTIME$(T%)+" LEFT",UCW%
  ENDIF
 ENDIF
 IF URN%>0 THEN
  F%=MAX(UFULL%,RTLEN%):A%=F%*URN%
  IF BK%==URN%-1 && F%>RTLEN% THEN A%=F%*(URN%-1)+RTLEN%
  UV 6,12,182,40,UN$(F%*BNEED%+B%)+" OF "+UN$(A%)+" B",UCW%
 ENDIF
END

DEF UTICKFILE
 VAR B%=LEN(RZC%),P#,S%
 P#=B%/MAX(RTLEN%,1)
 UVR 1,102,28,UN$(B%)+" OF "+UN$(RTLEN%)+" B   "+STR$(INT(P#*100))+"%",UCW%
 UBARTO P#
 S%=USPEED(B%)
 IF S%>0 THEN
  UV 3,12,152,14,UN$(S%)+" B/S",UCW%
  UV 4,140,152,15,UTIME$(INT((RTLEN%-B%)/S%))+" LEFT",UCW%
 ENDIF
 IF PG%==0 && LOSTP%>0 THEN UV 7,12,200,30,UMISS$(LOSTP%),UCY%
END

'A PART HAS COME AND IS BEING SAVED
DEF USAVING
 UBARTO 1
 UPARTFILL 1
 UCLR 12,30,20,16
 UBIG 30,"SAVING PART "+STR$(BK%),UCK%
 UVR 1,102,28,UN$(RTLEN%)+" OF "+UN$(RTLEN%)+" B   100%",UCW%
END

DEF UFAIL T$,R$
 UMODE%=0
 UCLS
 UHEAD "USB RECEIVE"
 UBIG 30,T$,UCY%
 USIGNAL USIG%
 UT 12,52,R$,UCL%
 IF URN%>0 THEN
  UT 12,70,"PARTS",UCL%:UTR 70,STR$(BNEED%)+" OF "+STR$(URN%),UCW%
  UPARTS
 ENDIF
 UBIG 116,"SET START PART "+STR$(BNEED%),UCY%
 UBIG 136,"ON FLIPPER",UCY%
 UT 12,172,"WAITING FOR PART "+STR$(BNEED%),UCL%
 UFOOT "[B] BACK","[X] UNFINISHED TRANSFERS"
END

'A PROBLEM THE SENDER'S USER MUST SOLVE, WITH THE PART THAT IS NEEDED
DEF BFAIL R$
 IF URN%>0 && BNEED%<URN% THEN UFP%[BNEED%]=1
 IF UTRYK%==BNEED% THEN INC UTRYN% ELSE UTRYK%=BNEED%:UTRYN%=1
 INC URT%
 UFAIL "PART "+STR$(BNEED%)+" FAILED",R$
 BALERT
END

'THE STREAM'S HEADER WAS CUT SHORT: BY THEN ANYTHING MIGHT HAVE BEEN COMING
DEF BLOSS R$
 IF STATE%==2 && !ARSET% THEN
  UAGAIN "TRANSFER FAILED",R$
 ELSE
  IF STATE%>=7 THEN R$=R$+" IN PART "+STR$(BK%)
  BFAIL R$
 ENDIF
END

DEF BAGAIN N%
 IF N%>=0 THEN UAGAIN "FILE FAILED",UMISS$(N%) ELSE UAGAIN "FILE FAILED","STREAM STOPPED"
END

DEF UAGAIN T$,R$
 UMODE%=0
 UCLS
 UHEAD "USB RECEIVE"
 UBIG 30,T$,UCY%
 USIGNAL USIG%
 UT 12,52,R$,UCL%
 UBIG 116,"TRY AGAIN",UCY%
 UT 12,172,"WAITING FOR FILE",UCL%
 UFOOT "[B] BACK",""
 BALERT
END

