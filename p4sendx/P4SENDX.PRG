'THE LAST SCREEN OF AN ARCHIVE
DEF UDONESCREEN
 VAR OK%=(BOK%==BENT% && BBAD%==0),I%,W%,Y%,R$,N$
 UCLS
 UHEAD "ARCHIVE "+HEXID$(ARID%)
 IF OK% THEN
  UBIG 30,"ALL DONE",UCK%
  UT 12,52,"STOP FLIPPER, THEN PRESS B.",UCW%
  UT 12,70,"PARTS",UCL%:UTR 70,STR$(ARN%)+" OF "+STR$(ARN%),UCW%
  UPARTS
  R$=STR$(BOK%-BNS%)+" WRITTEN"
  IF BNS%>0 THEN R$=R$+", "+STR$(BNS%)+" IGNORED"
  UT 12,102,"FILES",UCL%:UTR 102,R$,UCW%
  GFILL 12,112,387,127,UCK%
  'OF THIS SESSION: WITH NOTHING RECEIVED, NOTHING TO SAY
  IF UTF%>0 THEN R$=UTIME$((MAINCNT()-UTF%) DIV 60) ELSE R$="-"
  USTAT 12,142,"TIME",R$,UCW%
  IF UACT%>0 THEN R$=UN$(INT(UTB%*60/UACT%))+" B/S" ELSE R$="-"
  USTAT 112,142,"AVERAGE",R$,UCW%
  USTAT 240,142,"REPAIRED",NPACK$(BREP%),UCK%
  USTAT 12,172,"UNPACK",FORMAT$("%.1F",BTIME%/1000)+" S",UCW%
  USTAT 112,172,"SAVE",FORMAT$("%.1F",BST%/1000)+" S",UCW%
  USTAT 240,172,"RETRIES",STR$(URT%),UCW%
  IF XM% THEN USTAT 112,192,"LATE",NPACK$(BLATE%),UCW%
  IF BDL%<ARN% THEN UT 12,200,STR$(ARN%-BDL%)+" PARTS NOT DELETED",UCY%
 ELSE
  R$=STR$(BOK%-BNS%)+" OF "+STR$(BENT%-BNS%)+" FILES WRITTEN"
  IF LEN(R$)>23 THEN R$="SOME FILES FAILED"
  UBIG 30,R$,UCY%
  UT 12,52,"PARTS KEPT. RUN USB RECEIVE TO RETRY.",UCW%
  R$=STR$(BOK%-BNS%)+" WRITTEN, "+STR$(BBAD%)+" FAILED"
  IF BNS%>0 THEN R$=R$+", "+STR$(BNS%)+" IGNORED"
  UT 12,70,"FILES",UCL%:UTR 70,R$,UCW%
  GFILL 12,80,387,91,UCG%
  IF BENT%>0 THEN
   W%=376*BOK%/BENT%
   IF W%>0 THEN GFILL 12,80,11+W%,91,UCK%
   IF BBAD%>0 THEN GFILL 12+W%+1,80,MIN(12+W%+376*BBAD%/BENT%,387),91,UCO%
  ENDIF
  UT 12,106,"FAILED",UCL%
  FOR I%=0 TO MIN(BBAD%,4)-1
   Y%=120+I%*14
   N$=BFLN$[I%]
   IF LEN(N$)+LEN(BFLR$[I%])+1>47 THEN N$=MID$(N$,0,46-LEN(BFLR$[I%]))
   UT 12,Y%,N$,UCW%:UTR Y%,BFLR$[I%],UCY%
  NEXT
  IF BBAD%>4 THEN UT 12,176,"AND "+STR$(BBAD%-4)+" MORE",UCY%
  USTAT 12,186,"UNPACK",FORMAT$("%.1F",BTIME%/1000)+" S",UCW%
  USTAT 112,186,"SAVE",FORMAT$("%.1F",BST%/1000)+" S",UCW%
  USTAT 240,186,"REPAIRED",NPACK$(BREP%),UCW%
  UFOOT "STOP FLIPPER, THEN PRESS B",""
  IF BMIS%>0 THEN UT 12,204,"GROUPS WITH MISREAD PACKET: "+STR$(BMIS%),UCY%
  IF XM% && BMIS%==0 THEN UT 12,204,"LATE: "+NPACK$(BLATE%),UCW%
  RETURN
 ENDIF
 UFOOT "[B] BACK",""
 IF BMIS%>0 THEN UT 12,204,"GROUPS WITH MISREAD PACKET: "+STR$(BMIS%),UCY%
END

'THE USER IS NEEDED: UNTIL A PART ARRIVES OR A BUTTON IS PRESSED, THE
'WAIT FOR A STREAM REPEATS THE SOUND. IT NEVER PLAYS DURING A PART.
DEF BALERT
 BGMPLAY 129
 BALARM%=1
 BALARMAT%=MAINCNT()+BALARMGAP%
END

DEF BLOG N$,R$
 IF BBAD%<4 THEN BFLN$[BBAD%]=N$:BFLR$[BBAD%]=R$
 INC BBAD%
 BGMPLAY 129
END

'IS THIS NAME IN THE LIST FROM FILES()?
DEF HASFILE(N$)
 VAR I%
 FOR I%=0 TO LEN(BFX$)-1
  IF BFX$[I%]==N$ THEN RETURN 1
 NEXT
 RETURN 0
END

'WHAT SAVEV AND SAVEG TAKE WITHOUT STOPPING THE PROGRAM
DEF GOODNAME(N$)
 VAR T$=MID$(N$,0,4),I%,C%,S$=MID$(N$,4,LEN(N$)-4)
 IF T$!="TXT:" && T$!="DAT:" && T$!="GRP:" THEN RETURN 0
 IF LEN(S$)<1 || LEN(S$)>32 || S$[0]=="." THEN RETURN 0
 FOR I%=0 TO LEN(S$)-1
  C%=ASC(S$[I%])
  IF C%>=48 && C%<=57 THEN CONTINUE
  IF C%>=65 && C%<=90 THEN CONTINUE
  IF C%!=45 && C%!=46 && C%!=64 && C%!=95 THEN RETURN 0
 NEXT
 VAR B$=S$
 I%=INSTR(S$,".")
 IF I%>=0 THEN B$=MID$(S$,0,I%)
 IF B$=="CON" || B$=="PRN" || B$=="AUX" || B$=="NUL" THEN RETURN 0
 IF LEN(B$)==4 && (MID$(B$,0,3)=="COM" || MID$(B$,0,3)=="LPT") THEN
  C%=ASC(B$[3])
  IF C%>=48 && C%<=57 THEN RETURN 0
 ENDIF
 RETURN 1
END

'P4SEND'S CRC OF N% BYTES HELD FOUR TO AN INT
DEF CRCW(A%[],T%[],N%)
 VAR C%=&HFFFF,I%,V%,W%=N%>>2
 FOR I%=0 TO W%-1
  V%=A%[I%]
  C%=T%[(C% XOR V%) AND 255] XOR (C%>>8)
  C%=T%[(C% XOR (V%>>8)) AND 255] XOR (C%>>8)
  C%=T%[(C% XOR (V%>>16)) AND 255] XOR (C%>>8)
  C%=T%[(C% XOR (V%>>24)) AND 255] XOR (C%>>8)
 NEXT
 IF (N% AND 3)!=0 THEN
  V%=A%[W%]
  FOR I%=1 TO N% AND 3
   C%=T%[(C% XOR V%) AND 255] XOR (C%>>8)
   V%=V%>>8
  NEXT
 ENDIF
 RETURN C% XOR &HFFFF
END

DEF CALC_CRC32TBL()
 DIM T%[256]
 VAR I%,J%,K%
 FOR I%=0 TO 255
  K%=I%
  FOR J%=0 TO 7
   IF (K% AND 1)==1 THEN
    K%=&HEDB88320 XOR ((K%>>1) AND &H7FFFFFFF)
   ELSE
    K%=(K%>>1) AND &H7FFFFFFF
   ENDIF
  NEXT
  T%[I%]=K%
 NEXT
 RETURN T%
END

'CRC-32 GOES ON FROM C%, OVER A% FROM ELEMENT S%
DEF CRC32W(C%,A%[],T%[],S%)
 VAR I%
 FOR I%=S% TO LEN(A%)-1
  C%=C% XOR A%[I%]
  C%=T%[C% AND 255] XOR ((C%>>8) AND &HFFFFFF)
  C%=T%[C% AND 255] XOR ((C%>>8) AND &HFFFFFF)
  C%=T%[C% AND 255] XOR ((C%>>8) AND &HFFFFFF)
  C%=T%[C% AND 255] XOR ((C%>>8) AND &HFFFFFF)
 NEXT
 RETURN C%
END
